@startuml iam-api-class-diagram
title Code View: SumaqAgro - RESTful API - IAM Component
caption Code diagram (C4 level 4) of the IAM Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  class EmailAddress <<record>>
  interface NotificationSender
}

package "com.sumaqagro.platform.iam" {
  package "domain.model" {
    package "aggregates" {
      class User {
        -email: EmailAddress
        -password: String
        -roles: Set<Role>
        +User(email: EmailAddress, password: String, roles: List<Role>)
        +addRole(role: Role): User
        +addRoles(roles: List<Role>): User
        +updatePassword(hashedPassword: String): void
      }
    }

    package "entities" {
      class Role {
        -id: Long
        -name: Roles
        +getStringName(): String
        +{static} getDefaultRole(): Role
        +{static} toRoleFromName(name: String): Role
      }

      class PasswordResetToken {
        -id: Long
        -userId: Long
        -token: String
        -expiresAt: Date
        -used: boolean
        +isExpired(): boolean
        +markAsUsed(): void
      }
    }

    package "valueobjects" {
      enum Roles {
        ROLE_FARMER
        ROLE_COOPERATIVE_MANAGER
        ROLE_AGRONOMIST
      }
    }

    package "commands" {
      class SignUpCommand <<record>> {
        -email: String
        -password: String
        -roles: List<Role>
      }
      class SignInCommand <<record>> {
        -email: String
        -password: String
      }
      class RequestPasswordResetCommand <<record>> {
        -email: String
      }
      class ResetPasswordCommand <<record>> {
        -token: String
        -newPassword: String
      }
      class SeedRolesCommand <<record>>
    }


    package "events" {
      class UserSignedUpEvent <<record>> {
        -userId: Long
        -email: String
        -roles: List<String>
      }
      class UserSignedInEvent <<record>> {
        -userId: Long
      }
    }
  }

  package "domain.services" {
    interface UserCommandService {
      +handle(command: SignUpCommand): Optional<User>
      +handle(command: SignInCommand): Optional<ImmutablePair<User, String>>
      +handle(command: RequestPasswordResetCommand): void
      +handle(command: ResetPasswordCommand): void
    }
    interface UserQueryService {
      +handle(query: GetUserByIdQuery): Optional<User>
      +handle(query: GetUserByEmailQuery): Optional<User>
      +handle(query: GetAllUsersQuery): List<User>
    }
    interface RoleCommandService {
      +handle(command: SeedRolesCommand): void
    }
  }

  package "application.internal" {
    package "commandservices" {
      class UserCommandServiceImpl {
        -userRepository: UserRepository
        -roleRepository: RoleRepository
        -passwordResetTokenRepository: PasswordResetTokenRepository
        -hashingService: HashingService
        -tokenService: TokenService
        -eventPublisher: ApplicationEventPublisher
        -notificationSender: NotificationSender
        +handle(command: SignUpCommand): Optional<User>
        +handle(command: SignInCommand): Optional<ImmutablePair<User, String>>
        +handle(command: RequestPasswordResetCommand): void
        +handle(command: ResetPasswordCommand): void
      }
      class RoleCommandServiceImpl {
        -roleRepository: RoleRepository
        +handle(command: SeedRolesCommand): void
      }
    }
    package "queryservices" {
      class UserQueryServiceImpl {
        -userRepository: UserRepository
        +handle(query: GetUserByIdQuery): Optional<User>
        +handle(query: GetUserByEmailQuery): Optional<User>
        +handle(query: GetAllUsersQuery): List<User>
      }
    }
    package "outboundservices" {
      interface HashingService {
        +encode(rawPassword: CharSequence): String
        +matches(rawPassword: CharSequence, encodedPassword: String): boolean
      }
      interface TokenService {
        +generateToken(username: String): String
        +getUsernameFromToken(token: String): String
        +validateToken(token: String): boolean
      }
    }
  }

  package "infrastructure" {
    package "persistence.jpa.repositories" {
      interface UserRepository {
        +findByEmail(email: EmailAddress): Optional<User>
        +existsByEmail(email: EmailAddress): boolean
      }
      interface RoleRepository {
        +findByName(name: Roles): Optional<Role>
        +existsByName(name: Roles): boolean
      }
      interface PasswordResetTokenRepository {
        +findByToken(token: String): Optional<PasswordResetToken>
      }
    }
    package "hashing.bcrypt.services" {
      class HashingServiceImpl {
        -passwordEncoder: BCryptPasswordEncoder
        +encode(rawPassword: CharSequence): String
        +matches(rawPassword: CharSequence, encodedPassword: String): boolean
      }
    }
    package "tokens.jwt.services" {
      class TokenServiceImpl {
        -secret: String
        -expirationDays: int
        +generateToken(username: String): String
        +getUsernameFromToken(token: String): String
        +validateToken(token: String): boolean
        -getSigningKey(): SecretKey
      }
    }
    package "authorization.sfs" {
      class WebSecurityConfiguration <<Configuration>> {
        -userDetailsService: UserDetailsService
        -tokenService: TokenService
        +securityFilterChain(http: HttpSecurity): SecurityFilterChain
        +authorizationRequestFilter(): BearerAuthorizationRequestFilter
      }
      class BearerAuthorizationRequestFilter {
        -tokenService: TokenService
        -userDetailsService: UserDetailsService
        #doFilterInternal(request: HttpServletRequest, response: HttpServletResponse, chain: FilterChain): void
      }
    }
  }

  package "interfaces" {
    package "rest" {
      class AuthenticationController <<RestController>> {
        -userCommandService: UserCommandService
        +signUp(resource: SignUpResource): ResponseEntity<UserResource>
        +signIn(resource: SignInResource): ResponseEntity<AuthenticatedUserResource>
        +forgotPassword(resource: ForgotPasswordResource): ResponseEntity<Void>
        +resetPassword(resource: ResetPasswordResource): ResponseEntity<Void>
      }
      class UsersController <<RestController>> {
        -userQueryService: UserQueryService
        +getAllUsers(): ResponseEntity<List<UserResource>>
        +getUserById(userId: Long): ResponseEntity<UserResource>
      }
    }
    package "rest.transform" {
      class SignUpCommandFromResourceAssembler {
        +{static} toCommandFromResource(resource: SignUpResource): SignUpCommand
      }
      class SignInCommandFromResourceAssembler {
        +{static} toCommandFromResource(resource: SignInResource): SignInCommand
      }
      class UserResourceFromEntityAssembler {
        +{static} toResourceFromEntity(user: User): UserResource
      }
      class AuthenticatedUserResourceFromEntityAssembler {
        +{static} toResourceFromEntity(user: User, token: String): AuthenticatedUserResource
      }
    }
    package "acl" {
      class IamContextFacade {
        -userCommandService: UserCommandService
        -userQueryService: UserQueryService
        +createUser(email: String, password: String, roleNames: List<String>): Long
        +fetchUserIdByEmail(email: String): Long
        +fetchEmailByUserId(userId: Long): String
        +assignRoleToUser(userId: Long, roleName: String): void
      }
    }
  }
}

User --|> AuditableAbstractAggregateRoot
User --> "1" EmailAddress
User "0..*" --> "1..*" Role : "has"
Role --> "1" Roles : "is named"
User "1" --> "0..*" PasswordResetToken : "requests"

UserCommandServiceImpl ..|> UserCommandService
UserQueryServiceImpl ..|> UserQueryService
RoleCommandServiceImpl ..|> RoleCommandService
HashingServiceImpl ..|> HashingService
TokenServiceImpl ..|> TokenService

UserCommandServiceImpl "1" --> "1" UserRepository
UserCommandServiceImpl "1" --> "1" RoleRepository
UserCommandServiceImpl "1" --> "1" PasswordResetTokenRepository
UserCommandServiceImpl "1" --> "1" NotificationSender
UserCommandServiceImpl "1" --> "1" HashingService
UserCommandServiceImpl "1" --> "1" TokenService
UserCommandServiceImpl ..> UserSignedUpEvent
UserQueryServiceImpl "1" --> "1" UserRepository
RoleCommandServiceImpl "1" --> "1" RoleRepository
WebSecurityConfiguration "1" *-- "1" BearerAuthorizationRequestFilter
BearerAuthorizationRequestFilter "1" --> "1" TokenService

AuthenticationController "1" --> "1" UserCommandService
UsersController "1" --> "1" UserQueryService
AuthenticationController ..> SignUpCommandFromResourceAssembler
AuthenticationController ..> SignInCommandFromResourceAssembler
AuthenticationController ..> AuthenticatedUserResourceFromEntityAssembler
UsersController ..> UserResourceFromEntityAssembler
IamContextFacade "1" --> "1" UserCommandService
IamContextFacade "1" --> "1" UserQueryService

note right of UserSignedUpEvent
  P1: handled by Subscriptions and Payments
  (Whenever UserSignedUp Then AssignSeedPlan).
end note

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

