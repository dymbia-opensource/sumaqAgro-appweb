@startuml profiles-api-class-diagram
title Code View: SumaqAgro - RESTful API - Profiles Component
caption Code diagram (C4 level 4) of the Profiles Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  abstract class AuditableModel
  interface NotificationSender
}

package "com.sumaqagro.platform.profiles" {
  package "domain.model" {
    package "aggregates" {
      class Profile {
        -userId: Long
        -name: PersonName
        -phoneNumber: PhoneNumber
        -photoUrl: String
        -preferredLanguage: PreferredLanguage
        +Profile(command: CreateProfileCommand)
        +update(command: UpdateProfileCommand): Profile
        +getFullName(): String
      }

      class Cooperative {
        -ruc: Ruc
        -businessName: String
        -region: String
        -managerUserId: Long
        -members: List<CooperativeMember>
        -invitations: List<AgronomistInvitation>
        +Cooperative(command: RegisterCooperativeCommand)
        +addMember(dni: Dni, name: PersonName, community: String): CooperativeMember
        +inviteAgronomist(email: String): AgronomistInvitation
        +acceptInvitation(invitationId: Long, agronomistUserId: Long): void
        +hasMember(dni: Dni): boolean
      }

      class AgronomistAssignment {
        -agronomistUserId: Long
        -plotId: Long
        -cooperativeId: Long
        -assignedAt: Date
        -active: boolean
        +AgronomistAssignment(command: AssignAgronomistToPlotCommand)
      }
    }

    package "entities" {
      class CooperativeMember {
        -dni: Dni
        -name: PersonName
        -community: String
        -joinedAt: Date
      }
      class AgronomistInvitation {
        -email: String
        -invitationToken: String
        -status: InvitationStatus
        -sentAt: Date
        +accept(): void
        +expire(): void
      }
    }

    package "valueobjects" {
      class PersonName <<record>> {
        -firstName: String
        -lastName: String
        +getFullName(): String
      }
      class PhoneNumber <<record>> {
        -number: String
      }
      class Ruc <<record>> {
        -value: String
      }
      class Dni <<record>> {
        -value: String
      }
      enum PreferredLanguage {
        ES
        EN
      }
      enum InvitationStatus {
        PENDING
        ACCEPTED
        EXPIRED
      }
    }

    package "commands" {
      class CreateProfileCommand <<record>>
      class UpdateProfileCommand <<record>> {
        -profileId: Long
        -firstName: String
        -lastName: String
        -phoneNumber: String
        -photoUrl: String
      }
      class RegisterCooperativeCommand <<record>> {
        -managerUserId: Long
        -ruc: String
        -businessName: String
        -region: String
      }
      class AddCooperativeMemberCommand <<record>> {
        -cooperativeId: Long
        -dni: String
        -firstName: String
        -lastName: String
        -community: String
      }
      class InviteAgronomistCommand <<record>> {
        -cooperativeId: Long
        -email: String
      }
      class AcceptAgronomistInvitationCommand <<record>> {
        -invitationToken: String
        -agronomistUserId: Long
      }
      class AssignAgronomistToPlotCommand <<record>> {
        -agronomistUserId: Long
        -plotId: Long
        -cooperativeId: Long
      }
    }


    package "events" {
      class ProfileUpdatedEvent <<record>>
      class CooperativeRegisteredEvent <<record>> {
        -cooperativeId: Long
        -managerUserId: Long
      }
      class CooperativeMemberAddedEvent <<record>>
      class AgronomistInvitedEvent <<record>> {
        -invitationId: Long
        -email: String
      }
      class AgronomistAssignedToPlotEvent <<record>>
    }
  }

  package "domain.services" {
    interface ProfileCommandService {
      +handle(command: CreateProfileCommand): Optional<Profile>
      +handle(command: UpdateProfileCommand): Optional<Profile>
    }
    interface CooperativeCommandService {
      +handle(command: RegisterCooperativeCommand): Optional<Cooperative>
      +handle(command: AddCooperativeMemberCommand): Optional<CooperativeMember>
      +handle(command: InviteAgronomistCommand): Optional<AgronomistInvitation>
      +handle(command: AcceptAgronomistInvitationCommand): void
    }
    interface AgronomistAssignmentCommandService {
      +handle(command: AssignAgronomistToPlotCommand): Optional<AgronomistAssignment>
    }
    interface ProfilesQueryService {
      +handle(query: GetProfileByUserIdQuery): Optional<Profile>
      +handle(query: GetCooperativeByIdQuery): Optional<Cooperative>
      +handle(query: GetMembersByCooperativeIdQuery): List<CooperativeMember>
      +handle(query: GetActiveAssignmentByPlotIdQuery): Optional<AgronomistAssignment>
    }
  }

  package "application.internal" {
    package "commandservices" {
      class ProfileCommandServiceImpl {
        -profileRepository: ProfileRepository
        +handle(command: CreateProfileCommand): Optional<Profile>
        +handle(command: UpdateProfileCommand): Optional<Profile>
      }
      class CooperativeCommandServiceImpl {
        -cooperativeRepository: CooperativeRepository
        -externalIamService: ExternalIamService
        -notificationSender: NotificationSender
        +handle(command: RegisterCooperativeCommand): Optional<Cooperative>
        +handle(command: AddCooperativeMemberCommand): Optional<CooperativeMember>
        +handle(command: InviteAgronomistCommand): Optional<AgronomistInvitation>
        +handle(command: AcceptAgronomistInvitationCommand): void
      }
      class AgronomistAssignmentCommandServiceImpl {
        -assignmentRepository: AgronomistAssignmentRepository
        -externalFieldManagementService: ExternalFieldManagementService
        +handle(command: AssignAgronomistToPlotCommand): Optional<AgronomistAssignment>
      }
    }
    package "queryservices" {
      class ProfilesQueryServiceImpl {
        -profileRepository: ProfileRepository
        -cooperativeRepository: CooperativeRepository
        -assignmentRepository: AgronomistAssignmentRepository
      }
    }
    package "outboundservices.acl" {
      class ExternalIamService {
        -iamContextFacade: IamContextFacade
        +assignRole(userId: Long, roleName: String): void
      }
      class ExternalFieldManagementService {
        -fieldManagementContextFacade: FieldManagementContextFacade
        +existsPlotById(plotId: Long): boolean
      }
    }
  }

  package "infrastructure.persistence.jpa.repositories" {
    interface ProfileRepository {
      +findByUserId(userId: Long): Optional<Profile>
    }
    interface CooperativeRepository {
      +findByRuc(ruc: Ruc): Optional<Cooperative>
      +existsByRuc(ruc: Ruc): boolean
    }
    interface AgronomistAssignmentRepository {
      +findByPlotIdAndActiveTrue(plotId: Long): Optional<AgronomistAssignment>
      +findByAgronomistUserId(agronomistUserId: Long): List<AgronomistAssignment>
    }
  }

  package "interfaces" {
    package "rest" {
      class ProfilesController <<RestController>> {
        +createProfile(resource: CreateProfileResource): ResponseEntity<ProfileResource>
        +getProfileByUserId(userId: Long): ResponseEntity<ProfileResource>
        +updateProfile(profileId: Long, resource: UpdateProfileResource): ResponseEntity<ProfileResource>
      }
      class CooperativesController <<RestController>> {
        +registerCooperative(resource: RegisterCooperativeResource): ResponseEntity<CooperativeResource>
        +addMember(cooperativeId: Long, resource: AddCooperativeMemberResource): ResponseEntity<CooperativeMemberResource>
        +getMembers(cooperativeId: Long): ResponseEntity<List<CooperativeMemberResource>>
        +inviteAgronomist(cooperativeId: Long, resource: InviteAgronomistResource): ResponseEntity<Void>
        +acceptInvitation(resource: AcceptInvitationResource): ResponseEntity<Void>
      }
      class AgronomistAssignmentsController <<RestController>> {
        +assign(resource: AssignAgronomistResource): ResponseEntity<AgronomistAssignmentResource>
      }
    }
    package "rest.transform" {
      class ProfileResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: Profile): ProfileResource
      }
      class CooperativeResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: Cooperative): CooperativeResource
      }
      class RegisterCooperativeCommandFromResourceAssembler {
        +{static} toCommandFromResource(resource: RegisterCooperativeResource, managerUserId: Long): RegisterCooperativeCommand
      }
      class AssignAgronomistCommandFromResourceAssembler {
        +{static} toCommandFromResource(resource: AssignAgronomistResource): AssignAgronomistToPlotCommand
      }
    }
    package "acl" {
      class ProfilesContextFacade {
        -profilesQueryService: ProfilesQueryService
        +fetchAssignedAgronomistUserIdByPlotId(plotId: Long): Long
        +fetchPhoneNumberByUserId(userId: Long): String
        +existsMemberInCooperative(memberId: Long, cooperativeId: Long): boolean
      }
    }
  }
}

Profile --|> AuditableAbstractAggregateRoot
Cooperative --|> AuditableAbstractAggregateRoot
AgronomistAssignment --|> AuditableAbstractAggregateRoot
CooperativeMember --|> AuditableModel
AgronomistInvitation --|> AuditableModel

Profile *-- "1" PersonName : "is named"
Profile *-- "1" PhoneNumber : "is contacted at"
Profile --> "1" PreferredLanguage : "prefers"
Cooperative *-- "1" Ruc : "is identified by"
Cooperative "1" *-- "0..*" CooperativeMember : "registers"
Cooperative "1" *-- "0..*" AgronomistInvitation : "sends"
CooperativeMember *-- "1" Dni : "is identified by"
AgronomistInvitation --> "1" InvitationStatus : "has"
Cooperative "1" --> "0..*" AgronomistAssignment : "manages"

ProfileCommandServiceImpl ..|> ProfileCommandService
CooperativeCommandServiceImpl ..|> CooperativeCommandService
AgronomistAssignmentCommandServiceImpl ..|> AgronomistAssignmentCommandService
ProfilesQueryServiceImpl ..|> ProfilesQueryService

ProfileCommandServiceImpl "1" --> "1" ProfileRepository
CooperativeCommandServiceImpl "1" --> "1" CooperativeRepository
CooperativeCommandServiceImpl "1" --> "1" ExternalIamService
CooperativeCommandServiceImpl "1" --> "1" NotificationSender
AgronomistAssignmentCommandServiceImpl "1" --> "1" AgronomistAssignmentRepository
AgronomistAssignmentCommandServiceImpl "1" --> "1" ExternalFieldManagementService

ProfilesController "1" --> "1" ProfileCommandService
CooperativesController "1" --> "1" CooperativeCommandService
AgronomistAssignmentsController "1" --> "1" AgronomistAssignmentCommandService
ProfilesController ..> ProfileResourceFromEntityAssembler
CooperativesController ..> CooperativeResourceFromEntityAssembler
CooperativesController ..> RegisterCooperativeCommandFromResourceAssembler
AgronomistAssignmentsController ..> AssignAgronomistCommandFromResourceAssembler
ProfilesContextFacade "1" --> "1" ProfilesQueryService

note bottom of ProfilesContextFacade
  Used by Crop Health (P7: notify the agronomist
  assigned to the plot) and by Harvest Certification
  (validate the cooperative member of a batch).
end note

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

