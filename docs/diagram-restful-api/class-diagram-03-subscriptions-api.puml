@startuml subscriptions-api-class-diagram
title Code View: SumaqAgro - RESTful API - Subscriptions and Payments Component
caption Code diagram (C4 level 4) of the Subscriptions and Payments Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  abstract class AuditableModel
  class Money <<record>>
}

package "com.sumaqagro.platform.subscriptions" {
  package "domain.model" {
    package "aggregates" {
      class Subscription {
        -userId: Long
        -plan: Plan
        -status: SubscriptionStatus
        -billingCycle: BillingCycle
        -period: SubscriptionPeriod
        -autoRenew: boolean
        -payments: List<Payment>
        +Subscription(userId: Long, plan: Plan)
        +changePlan(plan: Plan, cycle: BillingCycle): void
        +registerPayment(amount: Money, transactionToken: String): Payment
        +activate(): void
        +cancel(): void
        +isActive(): boolean
        +canRegisterPlot(registeredPlots: int): boolean
      }
    }

    package "entities" {
      class Plan {
        -code: PlanCode
        -name: String
        -monthlyPrice: Money
        -annualPrice: Money
        -plotQuota: int
        +priceFor(cycle: BillingCycle): Money
        +isFree(): boolean
      }
      class Payment {
        -amount: Money
        -transactionToken: String
        -status: PaymentStatus
        -paidAt: Date
        +confirm(): void
        +reject(reason: String): void
      }
    }

    package "valueobjects" {
      class SubscriptionPeriod <<record>> {
        -startDate: LocalDate
        -endDate: LocalDate
        +isExpired(today: LocalDate): boolean
        +renew(cycle: BillingCycle): SubscriptionPeriod
      }
      enum PlanCode {
        SEED
        COOPERATIVE_PRO
        TECHNICAL_ADVISOR
      }
      enum SubscriptionStatus {
        ACTIVE
        CANCELLED
      }
      enum BillingCycle {
        MONTHLY
        ANNUAL
      }
      enum PaymentStatus {
        PENDING
        COMPLETED
        REJECTED
      }
    }

    package "commands" {
      class AssignSeedPlanCommand <<record>> {
        -userId: Long
      }
      class SelectSubscriptionPlanCommand <<record>> {
        -subscriptionId: Long
        -planCode: PlanCode
        -billingCycle: BillingCycle
      }
      class SubmitPaymentCommand <<record>> {
        -subscriptionId: Long
        -cardToken: String
      }
      class ConfirmPaymentCommand <<record>> {
        -transactionToken: String
        -signature: String
      }
      class ActivateSubscriptionCommand <<record>> {
        -subscriptionId: Long
      }
      class CancelSubscriptionCommand <<record>> {
        -subscriptionId: Long
      }
    }


    package "events" {
      class SeedPlanAssignedEvent <<record>>
      class SubscriptionPlanSelectedEvent <<record>>
      class PaymentConfirmedEvent <<record>> {
        -subscriptionId: Long
        -paymentId: Long
      }
      class SubscriptionActivatedEvent <<record>>
      class SubscriptionCancelledEvent <<record>>
    }
  }

  package "domain.services" {
    interface SubscriptionCommandService {
      +handle(command: AssignSeedPlanCommand): Optional<Subscription>
      +handle(command: SelectSubscriptionPlanCommand): Optional<Subscription>
      +handle(command: SubmitPaymentCommand): Optional<Payment>
      +handle(command: ConfirmPaymentCommand): void
      +handle(command: ActivateSubscriptionCommand): void
      +handle(command: CancelSubscriptionCommand): void
    }
    interface SubscriptionQueryService {
      +handle(query: GetAllPlansQuery): List<Plan>
      +handle(query: GetSubscriptionByUserIdQuery): Optional<Subscription>
      +handle(query: GetPaymentsBySubscriptionIdQuery): List<Payment>
    }
  }

  package "application.internal" {
    package "commandservices" {
      class SubscriptionCommandServiceImpl {
        -subscriptionRepository: SubscriptionRepository
        -planRepository: PlanRepository
        -niubizClientAssembler: NiubizClientAssembler
        -eventPublisher: ApplicationEventPublisher
      }
    }
    package "queryservices" {
      class SubscriptionQueryServiceImpl {
        -subscriptionRepository: SubscriptionRepository
        -planRepository: PlanRepository
      }
    }
    package "eventhandlers" {
      class UserSignedUpEventHandler <<P1>> {
        -subscriptionCommandService: SubscriptionCommandService
        +on(event: UserSignedUpEvent): void
      }
      class PaymentConfirmedEventHandler <<P2>> {
        -subscriptionCommandService: SubscriptionCommandService
        +on(event: PaymentConfirmedEvent): void
      }
    }
  }

  package "infrastructure" {
    package "persistence.jpa.repositories" {
      interface SubscriptionRepository {
        +findByUserId(userId: Long): Optional<Subscription>
      }
      interface PlanRepository {
        +findByCode(code: PlanCode): Optional<Plan>
      }
    }
    package "assemblers" {
      class NiubizClientAssembler {
        -merchantId: String
        -apiKey: String
        -restClient: RestClient
        +createCharge(amount: Money, cardToken: String): NiubizChargeResult
        +verifyWebhookSignature(payload: String, signature: String): boolean
        -toChargeRequest(amount: Money, cardToken: String): NiubizChargeRequest
      }
      class NiubizChargeResult <<record>> {
        -transactionToken: String
        -approved: boolean
      }
    }
  }

  package "interfaces" {
    package "rest" {
      class PlansController <<RestController>> {
        +getAllPlans(): ResponseEntity<List<PlanResource>>
      }
      class SubscriptionsController <<RestController>> {
        +getMySubscription(userId: Long): ResponseEntity<SubscriptionResource>
        +selectPlan(subscriptionId: Long, resource: SelectPlanResource): ResponseEntity<SubscriptionResource>
        +submitPayment(subscriptionId: Long, resource: SubmitPaymentResource): ResponseEntity<PaymentResource>
        +cancel(subscriptionId: Long): ResponseEntity<SubscriptionResource>
        +getPayments(subscriptionId: Long): ResponseEntity<List<PaymentResource>>
      }
      class PaymentsWebhookController <<RestController>> {
        +handleWebhook(payload: String, signature: String): ResponseEntity<Void>
      }
    }
    package "rest.transform" {
      class SubscriptionResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: Subscription): SubscriptionResource
      }
      class PlanResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: Plan): PlanResource
      }
      class SelectPlanCommandFromResourceAssembler {
        +{static} toCommandFromResource(subscriptionId: Long, resource: SelectPlanResource): SelectSubscriptionPlanCommand
      }
    }
    package "acl" {
      class SubscriptionsContextFacade {
        -subscriptionQueryService: SubscriptionQueryService
        +fetchPlotQuotaByUserId(userId: Long): int
        +hasActiveSubscription(userId: Long): boolean
      }
    }
  }
}

Subscription --|> AuditableAbstractAggregateRoot
Plan --|> AuditableModel
Payment --|> AuditableModel

Subscription "0..*" --> "1" Plan : "is based on"
Subscription "1" *-- "0..*" Payment : "is paid by"
Subscription *-- "1" SubscriptionPeriod : "is valid during"
Subscription --> "1" SubscriptionStatus : "has"
Subscription --> "1" BillingCycle : "is billed"
Plan --> "1" PlanCode : "is identified by"
Plan *-- "2" Money
Payment --> "1" PaymentStatus : "has"
Payment *-- "1" Money

SubscriptionCommandServiceImpl ..|> SubscriptionCommandService
SubscriptionQueryServiceImpl ..|> SubscriptionQueryService
SubscriptionCommandServiceImpl "1" --> "1" SubscriptionRepository
SubscriptionCommandServiceImpl "1" --> "1" PlanRepository
SubscriptionCommandServiceImpl "1" --> "1" NiubizClientAssembler
SubscriptionCommandServiceImpl ..> PaymentConfirmedEvent
SubscriptionQueryServiceImpl "1" --> "1" SubscriptionRepository
NiubizClientAssembler ..> NiubizChargeResult
UserSignedUpEventHandler ..> AssignSeedPlanCommand
PaymentConfirmedEventHandler ..> ActivateSubscriptionCommand
UserSignedUpEventHandler "1" --> "1" SubscriptionCommandService
PaymentConfirmedEventHandler "1" --> "1" SubscriptionCommandService

PlansController "1" --> "1" SubscriptionQueryService
SubscriptionsController "1" --> "1" SubscriptionCommandService
SubscriptionsController "1" --> "1" SubscriptionQueryService
PaymentsWebhookController "1" --> "1" SubscriptionCommandService
SubscriptionsController ..> SubscriptionResourceFromEntityAssembler
SubscriptionsController ..> SelectPlanCommandFromResourceAssembler
PlansController ..> PlanResourceFromEntityAssembler
SubscriptionsContextFacade "1" --> "1" SubscriptionQueryService

note bottom of SubscriptionsContextFacade
  Used by Field Management to check the plot quota
  of the user's plan before registering a new plot.
end note

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

