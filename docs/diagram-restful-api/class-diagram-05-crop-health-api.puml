@startuml crop-health-api-class-diagram
title Code View: SumaqAgro - RESTful API - Crop Health Component
caption Code diagram (C4 level 4) of the Crop Health Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  abstract class AuditableModel
  interface NotificationSender
}

package "com.sumaqagro.platform.crophealth" {
  package "domain.model" {
    package "aggregates" {
      class SatelliteObservation {
        -plotId: Long
        -polygonId: String
        -capturedAt: Date
        -source: SatelliteSource
        -cloudCoverage: BigDecimal
        -indexes: VegetationIndexes
        -discarded: boolean
        +isUsable(): boolean
        +discard(): void
        +recordIndexes(indexes: VegetationIndexes): void
        +detectAnomaly(previous: SatelliteObservation): boolean
        +hasWaterStress(): boolean
      }

      class ClimateForecast {
        -plotId: Long
        -forecastDate: LocalDate
        -temperature: TemperatureRange
        -precipitationMm: BigDecimal
        +hasFrostRisk(): boolean
      }

      class AgroclimaticAlert {
        -plotId: Long
        -type: AlertType
        -severity: AlertSeverity
        -status: AlertStatus
        -raisedAt: Date
        -actionSteps: List<ActionStep>
        +AgroclimaticAlert(command: RaiseAgroclimaticAlertCommand)
        +completeStep(actionStepId: Long): void
        +close(): void
        +requiresNotification(): boolean
      }

      class RegionalBulletin {
        -agronomistUserId: Long
        -region: String
        -title: String
        -preventiveMeasures: String
        -issuedAt: Date
      }

      class PestReport {
        -plotId: Long
        -farmerUserId: Long
        -assignedAgronomistUserId: Long
        -evidence: PhotoEvidence
        -comments: String
        -damageAssessment: String
        -status: PestReportStatus
        -clientSyncId: UUID
        +recordDamageAssessment(assessment: String): void
        +markPrescribed(): void
        +reopen(): void
        +resolve(): void
      }

      class FieldInspection {
        -pestReportId: Long
        -agronomistUserId: Long
        -scheduledAt: LocalDateTime
        -completedAt: LocalDateTime
        -findings: String
        -status: InspectionStatus
        +complete(findings: String): void
      }

      class TechnicalPrescription {
        -pestReportId: Long
        -agronomistUserId: Long
        -product: String
        -dosage: Dosage
        -frequency: String
        -waitingPeriodDays: int
        -status: PrescriptionStatus
        +confirmApplication(): void
        +reportFoliageRecovery(pestPersists: boolean): void
        +evaluateEffectiveness(effective: boolean): void
      }
    }

    package "entities" {
      class ActionStep {
        -description: String
        -scheduledAt: LocalDateTime
        -completed: boolean
        +complete(): void
      }
    }

    package "valueobjects" {
      class VegetationIndexes <<record>> {
        -ndvi: BigDecimal
        -ndwi: BigDecimal
      }
      class TemperatureRange <<record>> {
        -minCelsius: BigDecimal
        -maxCelsius: BigDecimal
      }
      class PhotoEvidence <<record>> {
        -url: String
        -uploadedAt: Date
      }
      class Dosage <<record>> {
        -quantity: BigDecimal
        -unit: String
        -per: String
      }
      enum SatelliteSource {
        SENTINEL_2
        LANDSAT_8
      }
      enum AlertType {
        VEGETATION_ANOMALY
        WATER_STRESS
        FROST_RISK
      }
      enum AlertSeverity {
        LOW
        MEDIUM
        CRITICAL
      }
      enum AlertStatus {
        ACTIVE
        MITIGATED
      }
      enum PestReportStatus {
        SUBMITTED
        UNDER_REVIEW
        PRESCRIBED
        IN_FOLLOW_UP
        RESOLVED
        REOPENED
      }
      enum InspectionStatus {
        SCHEDULED
        COMPLETED
      }
      enum PrescriptionStatus {
        PENDING_APPLICATION
        APPLIED
        EVALUATED
      }
    }

    package "commands" {
      class ScheduleSatelliteMonitoringCommand <<record>> {
        -plotId: Long
        -polygonId: String
      }
      class FetchSatelliteImageryCommand <<record>>
      class RecordVegetationIndexesCommand <<record>> {
        -observationId: Long
        -ndvi: BigDecimal
        -ndwi: BigDecimal
      }
      class FetchClimateForecastCommand <<record>>
      class RaiseAgroclimaticAlertCommand <<record>> {
        -plotId: Long
        -type: AlertType
        -severity: AlertSeverity
      }
      class NotifyFarmerAndAgronomistCommand <<record>>
      class CompleteActionStepCommand <<record>>
      class CloseAlertCommand <<record>>
      class IssueRegionalBulletinCommand <<record>>
      class UploadPestEvidencePhotoCommand <<record>> {
        -plotId: Long
        -farmerUserId: Long
        -photo: MultipartFile
        -comments: String
        -clientSyncId: UUID
      }
      class NotifyAssignedAgronomistCommand <<record>>
      class RecordDamageAssessmentCommand <<record>>
      class ScheduleFieldInspectionCommand <<record>>
      class CompleteFieldInspectionCommand <<record>>
      class IssueTechnicalPrescriptionCommand <<record>>
      class ConfirmTreatmentApplicationCommand <<record>>
      class ReportFoliageRecoveryCommand <<record>>
      class EvaluateTreatmentEffectivenessCommand <<record>>
    }

    package "events" {
      class SatelliteMonitoringScheduledEvent <<record>>
      class SatelliteImageryIngestedEvent <<record>>
      class CloudyImageryDiscardedEvent <<record>>
      class NDVIIndexComputedEvent <<record>>
      class NDWIIndexComputedEvent <<record>>
      class ClimateForecastUpdatedEvent <<record>>
      class VegetationAnomalyDetectedEvent <<record>>
      class WaterStressDetectedEvent <<record>>
      class FrostRiskDetectedEvent <<record>>
      class AgroclimaticAlertRaisedEvent <<record>> {
        -alertId: Long
        -plotId: Long
        -severity: AlertSeverity
      }
      class AlertNotificationSentEvent <<record>>
      class ActionStepCompletedEvent <<record>>
      class AlertMitigatedEvent <<record>>
      class RegionalBulletinIssuedEvent <<record>>
      class PestEvidencePhotoUploadedEvent <<record>> {
        -pestReportId: Long
        -plotId: Long
      }
      class AgronomistNotifiedEvent <<record>>
      class DamageAssessmentRecordedEvent <<record>>
      class FieldInspectionScheduledEvent <<record>>
      class FieldInspectionCompletedEvent <<record>>
      class TechnicalPrescriptionIssuedEvent <<record>>
      class TreatmentApplicationConfirmedEvent <<record>>
      class FoliageRecoveryReportedEvent <<record>>
      class TreatmentEffectivenessEvaluatedEvent <<record>>
    }
  }

  package "domain.services" {
    interface SatelliteMonitoringCommandService {
      +handle(command: ScheduleSatelliteMonitoringCommand): void
      +handle(command: FetchSatelliteImageryCommand): List<SatelliteObservation>
      +handle(command: RecordVegetationIndexesCommand): Optional<SatelliteObservation>
      +handle(command: FetchClimateForecastCommand): List<ClimateForecast>
    }
    interface AgroclimaticAlertCommandService {
      +handle(command: RaiseAgroclimaticAlertCommand): Optional<AgroclimaticAlert>
      +handle(command: NotifyFarmerAndAgronomistCommand): void
      +handle(command: CompleteActionStepCommand): Optional<AgroclimaticAlert>
      +handle(command: CloseAlertCommand): Optional<AgroclimaticAlert>
      +handle(command: IssueRegionalBulletinCommand): Optional<RegionalBulletin>
    }
    interface AgronomicAdvisoryCommandService {
      +handle(command: UploadPestEvidencePhotoCommand): Optional<PestReport>
      +handle(command: NotifyAssignedAgronomistCommand): void
      +handle(command: RecordDamageAssessmentCommand): Optional<PestReport>
      +handle(command: ScheduleFieldInspectionCommand): Optional<FieldInspection>
      +handle(command: CompleteFieldInspectionCommand): Optional<FieldInspection>
      +handle(command: IssueTechnicalPrescriptionCommand): Optional<TechnicalPrescription>
      +handle(command: ConfirmTreatmentApplicationCommand): Optional<TechnicalPrescription>
      +handle(command: ReportFoliageRecoveryCommand): Optional<TechnicalPrescription>
      +handle(command: EvaluateTreatmentEffectivenessCommand): Optional<TechnicalPrescription>
    }
    interface CropHealthQueryService
  }

  package "application.internal" {
    package "commandservices" {
      class SatelliteMonitoringCommandServiceImpl {
        -observationRepository: SatelliteObservationRepository
        -forecastRepository: ClimateForecastRepository
        -agroMonitoringClientAssembler: AgroMonitoringClientAssembler
        -eventPublisher: ApplicationEventPublisher
      }
      class AgroclimaticAlertCommandServiceImpl {
        -alertRepository: AgroclimaticAlertRepository
        -bulletinRepository: RegionalBulletinRepository
        -notificationSender: NotificationSender
        -externalProfilesService: ExternalProfilesService
      }
      class AgronomicAdvisoryCommandServiceImpl {
        -pestReportRepository: PestReportRepository
        -inspectionRepository: FieldInspectionRepository
        -prescriptionRepository: TechnicalPrescriptionRepository
        -externalProfilesService: ExternalProfilesService
        -notificationSender: NotificationSender
      }
    }
    package "queryservices" {
      class CropHealthQueryServiceImpl
    }
    package "eventhandlers" {
      class SowingDateRecordedEventHandler <<P4>> {
        +on(event: SowingDateRecordedEvent): void
      }
      class CropRiskDetectedEventHandler <<P5>> {
        +on(event: VegetationAnomalyDetectedEvent): void
        +on(event: WaterStressDetectedEvent): void
        +on(event: FrostRiskDetectedEvent): void
      }
      class AgroclimaticAlertRaisedEventHandler <<P6>> {
        +on(event: AgroclimaticAlertRaisedEvent): void
      }
      class PestEvidencePhotoUploadedEventHandler <<P7>> {
        +on(event: PestEvidencePhotoUploadedEvent): void
      }
      class SatelliteMonitoringScheduler {
        +fetchImageryEveryFiveDays(): void
        +fetchForecastDaily(): void
      }
    }
    package "outboundservices.acl" {
      class ExternalFieldManagementService {
        -fieldManagementContextFacade: FieldManagementContextFacade
        +fetchPolygonIdByPlotId(plotId: Long): String
        +fetchPlotIdsByRegion(region: String): List<Long>
      }
      class ExternalProfilesService {
        -profilesContextFacade: ProfilesContextFacade
        +fetchAssignedAgronomistUserId(plotId: Long): Long
        +fetchPhoneNumber(userId: Long): String
      }
    }
  }

  package "infrastructure" {
    package "persistence.jpa.repositories" {
      interface SatelliteObservationRepository {
        +findTopByPlotIdAndDiscardedFalseOrderByCapturedAtDesc(plotId: Long): Optional<SatelliteObservation>
      }
      interface ClimateForecastRepository
      interface AgroclimaticAlertRepository {
        +findAllByPlotIdAndStatus(plotId: Long, status: AlertStatus): List<AgroclimaticAlert>
      }
      interface RegionalBulletinRepository
      interface PestReportRepository {
        +findAllByAssignedAgronomistUserId(agronomistUserId: Long): List<PestReport>
      }
      interface FieldInspectionRepository
      interface TechnicalPrescriptionRepository
    }
    package "assemblers" {
      class AgroMonitoringClientAssembler {
        -apiKey: String
        -restClient: RestClient
        +fetchSatelliteImagery(polygonId: String, from: Instant, to: Instant): List<SatelliteObservation>
        +fetchVegetationIndexes(polygonId: String, imageUrl: String): VegetationIndexes
        +fetchWeatherForecast(polygonId: String): List<ClimateForecast>
        -toObservation(response: AgroMonitoringImageResponse): SatelliteObservation
        -toForecast(response: AgroMonitoringWeatherResponse): ClimateForecast
      }
    }
    package "storage" {
      class PhotoStorageService {
        +upload(photo: MultipartFile): String
      }
    }
  }

  package "interfaces" {
    package "rest" {
      class MonitoringController <<RestController>> {
        +getObservations(plotId: Long): ResponseEntity<List<SatelliteObservationResource>>
        +getForecast(plotId: Long): ResponseEntity<List<ClimateForecastResource>>
      }
      class AlertsController <<RestController>> {
        +getAlerts(plotId: Long): ResponseEntity<List<AgroclimaticAlertResource>>
        +completeStep(alertId: Long, stepId: Long): ResponseEntity<AgroclimaticAlertResource>
        +close(alertId: Long): ResponseEntity<AgroclimaticAlertResource>
        +issueBulletin(resource: IssueBulletinResource): ResponseEntity<RegionalBulletinResource>
      }
      class AdvisoryController <<RestController>> {
        +uploadPestReport(resource: UploadPestReportResource): ResponseEntity<PestReportResource>
        +getInbox(agronomistUserId: Long): ResponseEntity<List<PestReportResource>>
        +scheduleInspection(reportId: Long, resource: ScheduleInspectionResource): ResponseEntity<FieldInspectionResource>
        +issuePrescription(reportId: Long, resource: IssuePrescriptionResource): ResponseEntity<TechnicalPrescriptionResource>
        +recordDamageAssessment(reportId: Long, resource: DamageAssessmentResource): ResponseEntity<PestReportResource>
        +completeInspection(inspectionId: Long, resource: InspectionFindingsResource): ResponseEntity<FieldInspectionResource>
        +confirmTreatment(prescriptionId: Long): ResponseEntity<TechnicalPrescriptionResource>
        +reportFoliageRecovery(prescriptionId: Long, resource: FoliageRecoveryResource): ResponseEntity<TechnicalPrescriptionResource>
        +evaluateEffectiveness(prescriptionId: Long, resource: EffectivenessResource): ResponseEntity<TechnicalPrescriptionResource>
      }
    }
    package "rest.transform" {
      class SatelliteObservationResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: SatelliteObservation): SatelliteObservationResource
      }
      class AgroclimaticAlertResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: AgroclimaticAlert): AgroclimaticAlertResource
      }
      class PestReportResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: PestReport): PestReportResource
      }
      class IssuePrescriptionCommandFromResourceAssembler {
        +{static} toCommandFromResource(reportId: Long, resource: IssuePrescriptionResource): IssueTechnicalPrescriptionCommand
      }
    }
  }
}

SatelliteObservation --|> AuditableAbstractAggregateRoot
ClimateForecast --|> AuditableAbstractAggregateRoot
AgroclimaticAlert --|> AuditableAbstractAggregateRoot
RegionalBulletin --|> AuditableAbstractAggregateRoot
PestReport --|> AuditableAbstractAggregateRoot
FieldInspection --|> AuditableAbstractAggregateRoot
TechnicalPrescription --|> AuditableAbstractAggregateRoot
ActionStep --|> AuditableModel

SatelliteObservation *-- "1" VegetationIndexes : "measures"
SatelliteObservation --> "1" SatelliteSource : "comes from"
ClimateForecast *-- "1" TemperatureRange : "forecasts"
AgroclimaticAlert "1" *-- "1..*" ActionStep : "plans"
AgroclimaticAlert --> "1" AlertType : "is of"
AgroclimaticAlert --> "1" AlertSeverity : "has"
AgroclimaticAlert --> "1" AlertStatus : "has"
PestReport *-- "1" PhotoEvidence : "is supported by"
PestReport --> "1" PestReportStatus : "has"
FieldInspection "0..*" --> "1" PestReport : "inspects"
FieldInspection --> "1" InspectionStatus : "has"
TechnicalPrescription "0..1" --> "1" PestReport : "treats"
TechnicalPrescription *-- "1" Dosage : "prescribes"
TechnicalPrescription --> "1" PrescriptionStatus : "has"

SatelliteMonitoringCommandServiceImpl ..|> SatelliteMonitoringCommandService
AgroclimaticAlertCommandServiceImpl ..|> AgroclimaticAlertCommandService
AgronomicAdvisoryCommandServiceImpl ..|> AgronomicAdvisoryCommandService
CropHealthQueryServiceImpl ..|> CropHealthQueryService

SatelliteMonitoringCommandServiceImpl "1" --> "1" SatelliteObservationRepository
SatelliteMonitoringCommandServiceImpl "1" --> "1" ClimateForecastRepository
SatelliteMonitoringCommandServiceImpl "1" --> "1" AgroMonitoringClientAssembler
SatelliteMonitoringCommandServiceImpl ..> VegetationAnomalyDetectedEvent
SatelliteMonitoringCommandServiceImpl ..> WaterStressDetectedEvent
SatelliteMonitoringCommandServiceImpl ..> FrostRiskDetectedEvent
AgroclimaticAlertCommandServiceImpl "1" --> "1" AgroclimaticAlertRepository
AgroclimaticAlertCommandServiceImpl "1" --> "1" RegionalBulletinRepository
AgroclimaticAlertCommandServiceImpl "1" --> "1" NotificationSender
AgroclimaticAlertCommandServiceImpl ..> AgroclimaticAlertRaisedEvent
AgronomicAdvisoryCommandServiceImpl "1" --> "1" PestReportRepository
AgronomicAdvisoryCommandServiceImpl "1" --> "1" FieldInspectionRepository
AgronomicAdvisoryCommandServiceImpl "1" --> "1" TechnicalPrescriptionRepository
AgronomicAdvisoryCommandServiceImpl "1" --> "1" PhotoStorageService
AgronomicAdvisoryCommandServiceImpl "1" --> "1" ExternalProfilesService
AgronomicAdvisoryCommandServiceImpl ..> PestEvidencePhotoUploadedEvent
SatelliteMonitoringCommandServiceImpl "1" --> "1" ExternalFieldManagementService

SowingDateRecordedEventHandler ..> ScheduleSatelliteMonitoringCommand
CropRiskDetectedEventHandler ..> RaiseAgroclimaticAlertCommand
AgroclimaticAlertRaisedEventHandler ..> NotifyFarmerAndAgronomistCommand
PestEvidencePhotoUploadedEventHandler ..> NotifyAssignedAgronomistCommand
SatelliteMonitoringScheduler ..> FetchSatelliteImageryCommand
SatelliteMonitoringScheduler ..> FetchClimateForecastCommand

MonitoringController "1" --> "1" CropHealthQueryService
AlertsController "1" --> "1" AgroclimaticAlertCommandService
AdvisoryController "1" --> "1" AgronomicAdvisoryCommandService
MonitoringController ..> SatelliteObservationResourceFromEntityAssembler
AlertsController ..> AgroclimaticAlertResourceFromEntityAssembler
AdvisoryController ..> PestReportResourceFromEntityAssembler
AdvisoryController ..> IssuePrescriptionCommandFromResourceAssembler

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

' --- vertical layout ---
SatelliteObservationResourceFromEntityAssembler -[hidden]down- IssuePrescriptionCommandFromResourceAssembler
SowingDateRecordedEventHandler -[hidden]down- PestEvidencePhotoUploadedEventHandler
CropRiskDetectedEventHandler -[hidden]down- SatelliteMonitoringScheduler
SatelliteMonitoringCommandService -[hidden]down- CropHealthQueryService
SatelliteObservationRepository -[hidden]down- RegionalBulletinRepository
ClimateForecastRepository -[hidden]down- PestReportRepository
AgroclimaticAlertRepository -[hidden]down- FieldInspectionRepository
RegionalBulletinRepository -[hidden]down- TechnicalPrescriptionRepository
SatelliteObservation -[hidden]down- RegionalBulletin
ClimateForecast -[hidden]down- PestReport
AgroclimaticAlert -[hidden]down- FieldInspection
RegionalBulletin -[hidden]down- TechnicalPrescription
VegetationIndexes -[hidden]down- Dosage
TemperatureRange -[hidden]down- SatelliteSource
PhotoEvidence -[hidden]down- AlertType
Dosage -[hidden]down- AlertSeverity
SatelliteSource -[hidden]down- AlertStatus
AlertType -[hidden]down- PestReportStatus
AlertSeverity -[hidden]down- InspectionStatus
AlertStatus -[hidden]down- PrescriptionStatus
ScheduleSatelliteMonitoringCommand -[hidden]down- FetchClimateForecastCommand
FetchSatelliteImageryCommand -[hidden]down- RaiseAgroclimaticAlertCommand
RecordVegetationIndexesCommand -[hidden]down- NotifyFarmerAndAgronomistCommand
FetchClimateForecastCommand -[hidden]down- CompleteActionStepCommand
RaiseAgroclimaticAlertCommand -[hidden]down- CloseAlertCommand
NotifyFarmerAndAgronomistCommand -[hidden]down- IssueRegionalBulletinCommand
CompleteActionStepCommand -[hidden]down- UploadPestEvidencePhotoCommand
