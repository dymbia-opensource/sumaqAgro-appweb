@startuml harvest-certification-api-class-diagram
title Code View: SumaqAgro - RESTful API - Harvest Certification Component
caption Code diagram (C4 level 4) of the Harvest Certification Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  abstract class AuditableModel
}

package "com.sumaqagro.platform.harvestcertification" {
  package "domain.model" {
    package "aggregates" {
      class HarvestBatch {
        -code: BatchCode
        -cooperativeId: Long
        -memberId: Long
        -plotId: Long
        -campaignId: Long
        -cropType: CropType
        -collectedAt: LocalDate
        -weight: BatchWeight
        -sample: RepresentativeSample
        -potatoGrading: PotatoCaliberGrading
        -cuppingResult: CoffeeCuppingResult
        -qualityCategory: QualityCategory
        -status: BatchStatus
        +HarvestBatch(command: RegisterHarvestBatchCommand)
        +weigh(grossKg: BigDecimal, sackCount: int, tarePerSackKg: BigDecimal): void
        +extractSample(weightKg: BigDecimal): void
        +gradePotatoCalibers(grading: PotatoCaliberGrading): void
        +performCoffeeCupping(result: CoffeeCuppingResult): void
        +assignQualityScore(): QualityCategory
        +isReadyForCertification(): boolean
      }

      class QualityCertificate {
        -batchId: Long
        -certificateNumber: String
        -hash: CertificateHash
        -issuedAt: Date
        -issuedByUserId: Long
        -qrCodeUrl: String
        -status: CertificateStatus
        +QualityCertificate(batch: HarvestBatch, issuedByUserId: Long)
        +revoke(reason: String): void
        +verify(hash: String): boolean
        +isValid(): boolean
      }
    }

    package "entities" {
      class RepresentativeSample {
        -weightKg: BigDecimal
        -extractedAt: Date
        +isSufficientFor(cropType: CropType): boolean
      }
    }

    package "valueobjects" {
      class BatchCode <<record>> {
        -value: String
        +{static} next(year: int, sequence: int): BatchCode
      }
      class BatchWeight <<record>> {
        -grossKg: BigDecimal
        -tareKg: BigDecimal
        +netKg(): BigDecimal
      }
      class PotatoCaliberGrading <<record>> {
        -firstPercentage: BigDecimal
        -secondPercentage: BigDecimal
        -thirdPercentage: BigDecimal
        -weevilDamagePercentage: BigDecimal
        +meetsCommercialStandard(): boolean
      }
      class CoffeeCuppingResult <<record>> {
        -aroma: BigDecimal
        -flavor: BigDecimal
        -acidity: BigDecimal
        -body: BigDecimal
        +totalScore(): BigDecimal
        +isSpecialty(): boolean
      }
      class CertificateHash <<record>> {
        -sha256: String
      }
      enum CropType {
        ANDEAN_POTATO
        SPECIALTY_COFFEE
      }
      enum BatchStatus {
        PENDING_GRADING
        GRADED
        CERTIFIED
      }
      enum QualityCategory {
        PREMIUM_GOLD
        STANDARD
        B_GRADE_REQUIRES_SORTING
        SPECIALTY_COFFEE
        COMMERCIAL_COFFEE
      }
      enum CertificateStatus {
        ACTIVE
        REVOKED
      }
    }

    package "commands" {
      class RegisterHarvestBatchCommand <<record>> {
        -cooperativeId: Long
        -memberId: Long
        -plotId: Long
        -campaignId: Long
        -cropType: CropType
        -collectedAt: LocalDate
      }
      class WeighDeliveredBatchCommand <<record>>
      class ExtractRepresentativeSampleCommand <<record>>
      class GradePotatoCalibersCommand <<record>>
      class PerformCoffeeCuppingCommand <<record>>
      class AssignQualityScoreCommand <<record>> {
        -batchId: Long
      }
      class IssueQualityCertificateCommand <<record>> {
        -batchId: Long
        -issuedByUserId: Long
      }
      class RevokeQualityCertificateCommand <<record>>
      class VerifyCertificateCommand <<record>> {
        -certificateNumber: String
        -hash: String
      }
    }


    package "events" {
      class HarvestBatchRegisteredEvent <<record>>
      class DeliveredBatchWeighedEvent <<record>> {
        -batchId: Long
        -campaignId: Long
        -netWeightKg: BigDecimal
      }
      class PotatoCalibersGradedEvent <<record>> {
        -batchId: Long
      }
      class CoffeeCuppingCompletedEvent <<record>> {
        -batchId: Long
      }
      class RepresentativeSampleExtractedEvent <<record>>
      class QualityScoreAssignedEvent <<record>>
      class QualityCertificateIssuedEvent <<record>>
      class TraceabilityQRCodeCreatedEvent <<record>>
      class CertificateVerifiedEvent <<record>>
    }
  }

  package "domain.services" {
    interface HarvestBatchCommandService {
      +handle(command: RegisterHarvestBatchCommand): Optional<HarvestBatch>
      +handle(command: WeighDeliveredBatchCommand): Optional<HarvestBatch>
      +handle(command: ExtractRepresentativeSampleCommand): Optional<HarvestBatch>
      +handle(command: GradePotatoCalibersCommand): Optional<HarvestBatch>
      +handle(command: PerformCoffeeCuppingCommand): Optional<HarvestBatch>
      +handle(command: AssignQualityScoreCommand): Optional<HarvestBatch>
    }
    interface QualityCertificateCommandService {
      +handle(command: IssueQualityCertificateCommand): Optional<QualityCertificate>
      +handle(command: RevokeQualityCertificateCommand): Optional<QualityCertificate>
      +handle(command: VerifyCertificateCommand): Optional<QualityCertificate>
    }
    interface HarvestCertificationQueryService {
      +handle(query: GetBatchesByCooperativeIdQuery): List<HarvestBatch>
      +handle(query: GetCertificatesByMemberIdQuery): List<QualityCertificate>
      +handle(query: GetPublicTraceabilityByCertificateNumberQuery): Optional<PublicTraceabilityView>
    }
  }

  package "application.internal" {
    package "commandservices" {
      class HarvestBatchCommandServiceImpl {
        -harvestBatchRepository: HarvestBatchRepository
        -externalProfilesService: ExternalProfilesService
        -eventPublisher: ApplicationEventPublisher
      }
      class QualityCertificateCommandServiceImpl {
        -certificateRepository: QualityCertificateRepository
        -harvestBatchRepository: HarvestBatchRepository
        -pdfQrGeneratorAssembler: PdfQrGeneratorAssembler
      }
    }
    package "queryservices" {
      class HarvestCertificationQueryServiceImpl {
        -harvestBatchRepository: HarvestBatchRepository
        -certificateRepository: QualityCertificateRepository
        -externalFieldManagementService: ExternalFieldManagementService
      }
      class PublicTraceabilityView <<record>> {
        -certificateNumber: String
        -originPlotName: String
        -originRegion: String
        -seedVariety: String
        -qualityCategory: QualityCategory
        -valid: boolean
      }
    }
    package "eventhandlers" {
      class BatchGradedEventHandler <<P11>> {
        +on(event: PotatoCalibersGradedEvent): void
        +on(event: CoffeeCuppingCompletedEvent): void
      }
    }
    package "outboundservices.acl" {
      class ExternalProfilesService {
        -profilesContextFacade: ProfilesContextFacade
        +existsMemberInCooperative(memberId: Long, cooperativeId: Long): boolean
      }
      class ExternalFieldManagementService {
        -fieldManagementContextFacade: FieldManagementContextFacade
        +fetchPlotOrigin(plotId: Long): String
        +fetchSeedVariety(campaignId: Long): String
      }
    }
  }

  package "infrastructure" {
    package "persistence.jpa.repositories" {
      interface HarvestBatchRepository {
        +findAllByCooperativeId(cooperativeId: Long): List<HarvestBatch>
        +countByCollectedAtYear(year: int): int
      }
      interface QualityCertificateRepository {
        +findByCertificateNumber(number: String): Optional<QualityCertificate>
        +findAllByBatchMemberId(memberId: Long): List<QualityCertificate>
      }
    }
    package "assemblers" {
      class PdfQrGeneratorAssembler {
        -publicVerificationBaseUrl: String
        +generateCertificatePdf(certificate: QualityCertificate, batch: HarvestBatch): byte[]
        +generateQrCode(certificateNumber: String): byte[]
        +computeHash(content: byte[]): CertificateHash
      }
    }
  }

  package "interfaces" {
    package "rest" {
      class HarvestBatchesController <<RestController>> {
        +registerBatch(resource: RegisterHarvestBatchResource): ResponseEntity<HarvestBatchResource>
        +weighBatch(batchId: Long, resource: WeighBatchResource): ResponseEntity<HarvestBatchResource>
        +extractSample(batchId: Long, resource: SampleResource): ResponseEntity<HarvestBatchResource>
        +gradePotato(batchId: Long, resource: PotatoGradingResource): ResponseEntity<HarvestBatchResource>
        +cupCoffee(batchId: Long, resource: CoffeeCuppingResource): ResponseEntity<HarvestBatchResource>
      }
      class QualityCertificatesController <<RestController>> {
        +issueCertificate(batchId: Long): ResponseEntity<QualityCertificateResource>
        +downloadPdf(certificateId: Long): ResponseEntity<byte[]>
        +downloadQrCode(certificateId: Long): ResponseEntity<byte[]>
        +revokeCertificate(certificateId: Long, resource: RevokeCertificateResource): ResponseEntity<QualityCertificateResource>
      }
      class PublicTraceabilityController <<RestController>> {
        +verify(certificateNumber: String, hash: String): ResponseEntity<PublicTraceabilityResource>
      }
    }
    package "rest.transform" {
      class HarvestBatchResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: HarvestBatch): HarvestBatchResource
      }
      class QualityCertificateResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: QualityCertificate): QualityCertificateResource
      }
      class RegisterHarvestBatchCommandFromResourceAssembler {
        +{static} toCommandFromResource(resource: RegisterHarvestBatchResource): RegisterHarvestBatchCommand
      }
    }
  }
}

HarvestBatch --|> AuditableAbstractAggregateRoot
QualityCertificate --|> AuditableAbstractAggregateRoot
RepresentativeSample --|> AuditableModel

HarvestBatch *-- "1" BatchCode : "is identified by"
HarvestBatch *-- "0..1" BatchWeight : "weighs"
HarvestBatch "1" *-- "0..1" RepresentativeSample : "is sampled by"
HarvestBatch *-- "0..1" PotatoCaliberGrading : "is graded by"
HarvestBatch *-- "0..1" CoffeeCuppingResult : "is cupped by"
HarvestBatch --> "1" CropType : "contains"
HarvestBatch --> "1" BatchStatus : "has"
HarvestBatch --> "0..1" QualityCategory : "is classified as"
QualityCertificate "0..1" --> "1" HarvestBatch : "certifies"
QualityCertificate *-- "1" CertificateHash : "is sealed by"
QualityCertificate --> "1" CertificateStatus : "has"

HarvestBatchCommandServiceImpl ..|> HarvestBatchCommandService
QualityCertificateCommandServiceImpl ..|> QualityCertificateCommandService
HarvestCertificationQueryServiceImpl ..|> HarvestCertificationQueryService

HarvestBatchCommandServiceImpl "1" --> "1" HarvestBatchRepository
HarvestBatchCommandServiceImpl "1" --> "1" ExternalProfilesService
HarvestBatchCommandServiceImpl ..> DeliveredBatchWeighedEvent
HarvestBatchCommandServiceImpl ..> PotatoCalibersGradedEvent
HarvestBatchCommandServiceImpl ..> CoffeeCuppingCompletedEvent
QualityCertificateCommandServiceImpl "1" --> "1" QualityCertificateRepository
QualityCertificateCommandServiceImpl "1" --> "1" PdfQrGeneratorAssembler
HarvestCertificationQueryServiceImpl "1" --> "1" ExternalFieldManagementService
HarvestCertificationQueryServiceImpl ..> PublicTraceabilityView
BatchGradedEventHandler ..> AssignQualityScoreCommand

HarvestBatchesController "1" --> "1" HarvestBatchCommandService
QualityCertificatesController "1" --> "1" QualityCertificateCommandService
PublicTraceabilityController "1" --> "1" QualityCertificateCommandService
PublicTraceabilityController "1" --> "1" HarvestCertificationQueryService
HarvestBatchesController ..> HarvestBatchResourceFromEntityAssembler
HarvestBatchesController ..> RegisterHarvestBatchCommandFromResourceAssembler
QualityCertificatesController ..> QualityCertificateResourceFromEntityAssembler

note bottom of DeliveredBatchWeighedEvent
  P10: handled by Field Management
  (Whenever DeliveredBatchWeighed Then RecordActualYield).
end note

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

