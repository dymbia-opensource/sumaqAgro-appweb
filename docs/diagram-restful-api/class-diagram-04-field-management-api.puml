@startuml field-management-api-class-diagram
title Code View: SumaqAgro - RESTful API - Field Management Component
caption Code diagram (C4 level 4) of the Field Management Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  abstract class AuditableAbstractAggregateRoot
  abstract class AuditableModel
  class Money <<record>>
}

package "com.sumaqagro.platform.fieldmanagement" {
  package "domain.model" {
    package "aggregates" {
      class FieldPlot {
        -ownerUserId: Long
        -name: String
        -region: String
        -boundary: PlotBoundary
        -area: Hectares
        -status: PlotStatus
        -agroMonitoringPolygonId: String
        -soilBaseline: SoilBaseline
        +FieldPlot(command: RegisterFieldPlotCommand)
        +delineateBoundary(coordinates: List<GeoCoordinate>): void
        +linkPolygon(polygonId: String): void
        +recordSoilBaseline(baseline: SoilBaseline): void
        +hasPolygon(): boolean
      }

      class CropCampaign {
        -plotId: Long
        -season: String
        -cropType: CropType
        -seedVariety: SeedVariety
        -sowingDate: LocalDate
        -status: CampaignStatus
        +CropCampaign(command: StartCropCampaignCommand)
        +selectCropType(cropType: CropType): void
        +specifySeedVariety(variety: SeedVariety): void
        +recordSowingDate(date: LocalDate): void
        +close(): void
        +isActive(): boolean
      }

      class CampaignLedger {
        -campaignId: Long
        -entries: List<ExpenseEntry>
        -expectedYield: Yield
        -actualYield: Yield
        -frozen: boolean
        +CampaignLedger(campaignId: Long)
        +recordInputExpense(command: RecordInputExpenseCommand): ExpenseEntry
        +recordDailyLaborExpense(command: RecordDailyLaborExpenseCommand): ExpenseEntry
        +recordFieldFreightExpense(command: RecordFieldFreightExpenseCommand): ExpenseEntry
        +setExpectedYield(yield: Yield): void
        +recordActualYield(yield: Yield): void
        +totalInvestment(): Money
        +totalByCategory(category: ExpenseCategory): Money
        +breakevenPrice(): Money
        +suggestedPrice(marginPercentage: BigDecimal): Money
        +freeze(): void
        +containsSyncId(clientSyncId: UUID): boolean
      }
    }

    package "entities" {
      class ExpenseEntry {
        -category: ExpenseCategory
        -description: String
        -quantity: BigDecimal
        -unitPrice: Money
        -expenseDate: LocalDate
        -notes: String
        -clientSyncId: UUID
        +total(): Money
      }
    }

    package "valueobjects" {
      class GeoCoordinate <<record>> {
        -latitude: double
        -longitude: double
      }
      class PlotBoundary <<record>> {
        -vertices: List<GeoCoordinate>
        +isClosed(): boolean
        +hasSelfIntersection(): boolean
        +calculateArea(): Hectares
      }
      class Hectares <<record>> {
        -value: BigDecimal
      }
      class SoilBaseline <<record>> {
        -ph: BigDecimal
        -texture: String
        -organicMatterPercentage: BigDecimal
        -recordedAt: LocalDate
        +needsLiming(cropType: CropType): boolean
      }
      class SeedVariety <<record>> {
        -name: String
        -custom: boolean
      }
      class Yield <<record>> {
        -quantity: BigDecimal
        -unit: YieldUnit
      }
      enum PlotStatus {
        WITHOUT_POLYGON
        ACTIVE_MONITORING
      }
      enum CropType {
        ANDEAN_POTATO
        SPECIALTY_COFFEE
      }
      enum CampaignStatus {
        IN_PROGRESS
        FINISHED
      }
      enum ExpenseCategory {
        INPUTS
        LABOR
        FREIGHT
      }
      enum YieldUnit {
        SACK
        QUINTAL
      }
    }

    package "commands" {
      class RegisterFieldPlotCommand <<record>> {
        -ownerUserId: Long
        -name: String
        -region: String
      }
      class DelineatePlotBoundaryCommand <<record>> {
        -plotId: Long
        -coordinates: List<GeoCoordinate>
      }
      class LinkPlotPolygonCommand <<record>> {
        -plotId: Long
      }
      class RecordSoilBaselineCommand <<record>>
      class StartCropCampaignCommand <<record>> {
        -plotId: Long
        -season: String
      }
      class SelectCropTypeCommand <<record>> {
        -campaignId: Long
        -cropType: CropType
      }
      class SpecifySeedVarietyCommand <<record>> {
        -campaignId: Long
        -varietyName: String
        -custom: boolean
      }
      class RecordSowingDateCommand <<record>> {
        -campaignId: Long
        -sowingDate: LocalDate
      }
      class CloseCropCampaignCommand <<record>>
      class OpenCampaignLedgerCommand <<record>> {
        -campaignId: Long
      }
      class RecordInputExpenseCommand <<record>> {
        -ledgerId: Long
        -inputName: String
        -quantity: BigDecimal
        -unitPrice: BigDecimal
        -expenseDate: LocalDate
        -clientSyncId: UUID
      }
      class RecordDailyLaborExpenseCommand <<record>> {
        -ledgerId: Long
        -workers: int
        -days: int
        -dailyWage: BigDecimal
        -expenseDate: LocalDate
        -clientSyncId: UUID
      }
      class RecordFieldFreightExpenseCommand <<record>> {
        -ledgerId: Long
        -route: String
        -cost: BigDecimal
        -expenseDate: LocalDate
        -clientSyncId: UUID
      }
      class SynchronizeExpensesCommand <<record>> {
        -inputExpenses: List<RecordInputExpenseCommand>
        -laborExpenses: List<RecordDailyLaborExpenseCommand>
        -freightExpenses: List<RecordFieldFreightExpenseCommand>
      }
      class SetExpectedYieldCommand <<record>>
      class RecalculateBreakevenPriceCommand <<record>>
      class RecordActualYieldCommand <<record>> {
        -campaignId: Long
        -netWeightKg: BigDecimal
      }
      class ExportCampaignCostReportCommand <<record>> {
        -campaignId: Long
      }
    }


    package "events" {
      class FieldPlotRegisteredEvent <<record>>
      class PlotBoundaryDelineatedEvent <<record>> {
        -plotId: Long
      }
      class PlotAreaCalculatedEvent <<record>>
      class PlotPolygonLinkedEvent <<record>>
      class SoilBaselineRecordedEvent <<record>>
      class CropCampaignStartedEvent <<record>> {
        -campaignId: Long
        -plotId: Long
      }
      class CropTypeSelectedEvent <<record>>
      class SeedVarietySpecifiedEvent <<record>>
      class SowingDateRecordedEvent <<record>> {
        -plotId: Long
        -polygonId: String
        -sowingDate: LocalDate
      }
      class CropCampaignClosedEvent <<record>>
      class CampaignLedgerOpenedEvent <<record>>
      class InputExpenseRecordedEvent <<record>> {
        -ledgerId: Long
      }
      class DailyLaborExpenseRecordedEvent <<record>> {
        -ledgerId: Long
      }
      class FieldFreightExpenseRecordedEvent <<record>> {
        -ledgerId: Long
      }
      class ExpectedYieldSetEvent <<record>> {
        -ledgerId: Long
      }
      class TotalInvestmentCalculatedEvent <<record>>
      class BreakevenPriceCalculatedEvent <<record>>
      class ActualYieldRecordedEvent <<record>>
      class CampaignCostReportExportedEvent <<record>>
    }
  }

  package "domain.services" {
    interface FieldPlotCommandService {
      +handle(command: RegisterFieldPlotCommand): Optional<FieldPlot>
      +handle(command: DelineatePlotBoundaryCommand): Optional<FieldPlot>
      +handle(command: LinkPlotPolygonCommand): void
      +handle(command: RecordSoilBaselineCommand): Optional<FieldPlot>
    }
    interface CropCampaignCommandService {
      +handle(command: StartCropCampaignCommand): Optional<CropCampaign>
      +handle(command: SelectCropTypeCommand): Optional<CropCampaign>
      +handle(command: SpecifySeedVarietyCommand): Optional<CropCampaign>
      +handle(command: RecordSowingDateCommand): Optional<CropCampaign>
      +handle(command: CloseCropCampaignCommand): Optional<CropCampaign>
    }
    interface CampaignLedgerCommandService {
      +handle(command: OpenCampaignLedgerCommand): Optional<CampaignLedger>
      +handle(command: RecordInputExpenseCommand): Optional<ExpenseEntry>
      +handle(command: RecordDailyLaborExpenseCommand): Optional<ExpenseEntry>
      +handle(command: RecordFieldFreightExpenseCommand): Optional<ExpenseEntry>
      +handle(command: SynchronizeExpensesCommand): SyncSummary
      +handle(command: SetExpectedYieldCommand): Optional<CampaignLedger>
      +handle(command: RecalculateBreakevenPriceCommand): Optional<Money>
      +handle(command: RecordActualYieldCommand): void
      +handle(command: ExportCampaignCostReportCommand): byte[]
    }
    interface FieldManagementQueryService {
      +handle(query: GetPlotsByOwnerIdQuery): List<FieldPlot>
      +handle(query: GetPlotByIdQuery): Optional<FieldPlot>
      +handle(query: GetCampaignsByPlotIdQuery): List<CropCampaign>
      +handle(query: GetLedgerByCampaignIdQuery): Optional<CampaignLedger>
    }
  }

  package "application.internal" {
    package "commandservices" {
      class FieldPlotCommandServiceImpl {
        -fieldPlotRepository: FieldPlotRepository
        -externalSubscriptionService: ExternalSubscriptionService
        -agroMonitoringPolygonAssembler: AgroMonitoringPolygonAssembler
      }
      class CropCampaignCommandServiceImpl {
        -cropCampaignRepository: CropCampaignRepository
      }
      class CampaignLedgerCommandServiceImpl {
        -campaignLedgerRepository: CampaignLedgerRepository
        -campaignCostReportGenerator: CampaignCostReportGenerator
      }
    }
    package "queryservices" {
      class FieldManagementQueryServiceImpl
    }
    package "eventhandlers" {
      class PlotBoundaryDelineatedEventHandler <<P3>> {
        +on(event: PlotBoundaryDelineatedEvent): void
      }
      class CropCampaignStartedEventHandler <<P8>> {
        +on(event: CropCampaignStartedEvent): void
      }
      class BreakevenRecalculationEventHandler <<P9>> {
        +on(event: InputExpenseRecordedEvent): void
        +on(event: DailyLaborExpenseRecordedEvent): void
        +on(event: FieldFreightExpenseRecordedEvent): void
        +on(event: ExpectedYieldSetEvent): void
      }
      class DeliveredBatchWeighedEventHandler <<P10>> {
        +on(event: DeliveredBatchWeighedEvent): void
      }
    }
    package "outboundservices.acl" {
      class ExternalSubscriptionService {
        -subscriptionsContextFacade: SubscriptionsContextFacade
        +canRegisterPlot(userId: Long, registeredPlots: int): boolean
      }
    }
  }

  package "infrastructure" {
    package "persistence.jpa.repositories" {
      interface FieldPlotRepository {
        +findAllByOwnerUserId(ownerUserId: Long): List<FieldPlot>
        +countByOwnerUserId(ownerUserId: Long): int
      }
      interface CropCampaignRepository {
        +existsByPlotIdAndStatus(plotId: Long, status: CampaignStatus): boolean
        +findAllByPlotId(plotId: Long): List<CropCampaign>
      }
      interface CampaignLedgerRepository {
        +findByCampaignId(campaignId: Long): Optional<CampaignLedger>
      }
    }
    package "assemblers" {
      class AgroMonitoringPolygonAssembler {
        -apiKey: String
        -restClient: RestClient
        +createPolygon(name: String, boundary: PlotBoundary): String
        +deletePolygon(polygonId: String): void
        -toGeoJson(boundary: PlotBoundary): AgroMonitoringPolygonRequest
      }
    }
    package "reports" {
      class CampaignCostReportGenerator {
        +generatePdf(ledger: CampaignLedger, campaign: CropCampaign): byte[]
      }
    }
  }

  package "interfaces" {
    package "rest" {
      class FieldPlotsController <<RestController>> {
        +registerPlot(resource: RegisterFieldPlotResource): ResponseEntity<FieldPlotResource>
        +delineateBoundary(plotId: Long, resource: DelineateBoundaryResource): ResponseEntity<FieldPlotResource>
        +recordSoilBaseline(plotId: Long, resource: SoilBaselineResource): ResponseEntity<FieldPlotResource>
        +getPlotsByOwner(ownerUserId: Long): ResponseEntity<List<FieldPlotResource>>
      }
      class CropCampaignsController <<RestController>> {
        +startCampaign(resource: StartCropCampaignResource): ResponseEntity<CropCampaignResource>
        +selectCropType(campaignId: Long, resource: SelectCropTypeResource): ResponseEntity<CropCampaignResource>
        +specifySeedVariety(campaignId: Long, resource: SeedVarietyResource): ResponseEntity<CropCampaignResource>
        +recordSowingDate(campaignId: Long, resource: SowingDateResource): ResponseEntity<CropCampaignResource>
        +closeCampaign(campaignId: Long): ResponseEntity<CropCampaignResource>
      }
      class FinancesController <<RestController>> {
        +getLedger(campaignId: Long): ResponseEntity<CampaignLedgerResource>
        +recordInputExpense(ledgerId: Long, resource: InputExpenseResource): ResponseEntity<ExpenseEntryResource>
        +recordDailyLaborExpense(ledgerId: Long, resource: DailyLaborExpenseResource): ResponseEntity<ExpenseEntryResource>
        +recordFieldFreightExpense(ledgerId: Long, resource: FieldFreightExpenseResource): ResponseEntity<ExpenseEntryResource>
        +setExpectedYield(ledgerId: Long, resource: ExpectedYieldResource): ResponseEntity<CampaignLedgerResource>
        +synchronize(resource: SyncExpensesResource): ResponseEntity<SyncSummaryResource>
        +getBreakeven(ledgerId: Long): ResponseEntity<BreakevenResource>
        +exportCostReport(campaignId: Long): ResponseEntity<byte[]>
      }
    }
    package "rest.transform" {
      class FieldPlotResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: FieldPlot): FieldPlotResource
      }
      class CampaignLedgerResourceFromEntityAssembler {
        +{static} toResourceFromEntity(entity: CampaignLedger): CampaignLedgerResource
      }
      class ExpenseCommandFromResourceAssembler {
        +{static} toCommandFromResource(ledgerId: Long, resource: InputExpenseResource): RecordInputExpenseCommand
        +{static} toCommandFromResource(ledgerId: Long, resource: DailyLaborExpenseResource): RecordDailyLaborExpenseCommand
        +{static} toCommandFromResource(ledgerId: Long, resource: FieldFreightExpenseResource): RecordFieldFreightExpenseCommand
      }
    }
    package "acl" {
      class FieldManagementContextFacade {
        -fieldManagementQueryService: FieldManagementQueryService
        +existsPlotById(plotId: Long): boolean
        +fetchPolygonIdByPlotId(plotId: Long): String
        +fetchPlotIdsByRegion(region: String): List<Long>
        +fetchPlotOriginByPlotId(plotId: Long): String
        +fetchSeedVarietyByCampaignId(campaignId: Long): String
      }
    }
  }
}

FieldPlot --|> AuditableAbstractAggregateRoot
CropCampaign --|> AuditableAbstractAggregateRoot
CampaignLedger --|> AuditableAbstractAggregateRoot
ExpenseEntry --|> AuditableModel

FieldPlot *-- "0..1" PlotBoundary : "is bounded by"
PlotBoundary *-- "3..*" GeoCoordinate : "has vertices"
FieldPlot *-- "0..1" Hectares : "measures"
FieldPlot *-- "0..1" SoilBaseline : "has"
FieldPlot --> "1" PlotStatus : "has"
FieldPlot "1" <-- "0..*" CropCampaign : "is sown in"
CropCampaign --> "1" CropType : "grows"
CropCampaign *-- "1" SeedVariety
CropCampaign --> "1" CampaignStatus : "has"
CampaignLedger "1" --> "1" CropCampaign : "costs"
CampaignLedger "1" *-- "0..*" ExpenseEntry : "records"
CampaignLedger *-- "0..2" Yield : "estimates"
Yield --> "1" YieldUnit : "is measured in"
ExpenseEntry --> "1" ExpenseCategory : "belongs to"
ExpenseEntry *-- "1" Money

FieldPlotCommandServiceImpl ..|> FieldPlotCommandService
CropCampaignCommandServiceImpl ..|> CropCampaignCommandService
CampaignLedgerCommandServiceImpl ..|> CampaignLedgerCommandService
FieldManagementQueryServiceImpl ..|> FieldManagementQueryService

FieldPlotCommandServiceImpl "1" --> "1" FieldPlotRepository
FieldPlotCommandServiceImpl "1" --> "1" ExternalSubscriptionService
FieldPlotCommandServiceImpl "1" --> "1" AgroMonitoringPolygonAssembler
FieldPlotCommandServiceImpl ..> PlotBoundaryDelineatedEvent
CropCampaignCommandServiceImpl "1" --> "1" CropCampaignRepository
CropCampaignCommandServiceImpl ..> CropCampaignStartedEvent
CropCampaignCommandServiceImpl ..> SowingDateRecordedEvent
CampaignLedgerCommandServiceImpl "1" --> "1" CampaignLedgerRepository
CampaignLedgerCommandServiceImpl "1" --> "1" CampaignCostReportGenerator
CampaignLedgerCommandServiceImpl ..> InputExpenseRecordedEvent
CampaignLedgerCommandServiceImpl ..> DailyLaborExpenseRecordedEvent
CampaignLedgerCommandServiceImpl ..> FieldFreightExpenseRecordedEvent
CampaignLedgerCommandServiceImpl ..> ExpectedYieldSetEvent

PlotBoundaryDelineatedEventHandler ..> LinkPlotPolygonCommand
CropCampaignStartedEventHandler ..> OpenCampaignLedgerCommand
BreakevenRecalculationEventHandler ..> RecalculateBreakevenPriceCommand
DeliveredBatchWeighedEventHandler ..> RecordActualYieldCommand

FieldPlotsController "1" --> "1" FieldPlotCommandService
CropCampaignsController "1" --> "1" CropCampaignCommandService
FinancesController "1" --> "1" CampaignLedgerCommandService
FieldPlotsController ..> FieldPlotResourceFromEntityAssembler
FinancesController ..> CampaignLedgerResourceFromEntityAssembler
FinancesController ..> ExpenseCommandFromResourceAssembler
FieldManagementContextFacade "1" --> "1" FieldManagementQueryService

note bottom of SowingDateRecordedEvent
  P4: handled by Crop Health
  (Whenever SowingDateRecorded Then ScheduleSatelliteMonitoring).
end note

note bottom of CampaignLedger
  Offline sync (TS-05): clientSyncId makes
  SynchronizeExpensesCommand idempotent.
end note

legend bottom left
  Command services publish every event of the
  events package. Arrows show only the events
  that trigger a policy (P1-P11).
endlegend

