@startuml shared-api-class-diagram
title Code View: SumaqAgro - RESTful API - Shared Kernel Component
caption Code diagram (C4 level 4) of the Shared Kernel Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "com.sumaqagro.platform.shared" {
  package "domain.model.aggregates" {
    abstract class "AuditableAbstractAggregateRoot<T>" as AuditableAbstractAggregateRoot {
      -id: Long
      -createdAt: Date
      -updatedAt: Date
      +getId(): Long
      +addDomainEvent(event: Object): void
    }
  }

  package "domain.model.entities" {
    abstract class AuditableModel {
      -id: Long
      -createdAt: Date
      -updatedAt: Date
      +getId(): Long
    }
  }

  package "domain.model.valueobjects" {
    class EmailAddress <<record>> {
      -address: String
      +EmailAddress(address: String)
      +address(): String
    }

    class Money <<record>> {
      -amount: BigDecimal
      -currency: String
      +Money(amount: BigDecimal, currency: String)
      +add(other: Money): Money
      +multiply(factor: BigDecimal): Money
      +divide(divisor: BigDecimal): Money
      +isGreaterThan(other: Money): boolean
    }
  }

  package "infrastructure.persistence.jpa.configuration.strategy" {
    class SnakeCaseWithPluralizedTablePhysicalNamingStrategy {
      +toPhysicalCatalogName(identifier: Identifier, env: JdbcEnvironment): Identifier
      +toPhysicalSchemaName(identifier: Identifier, env: JdbcEnvironment): Identifier
      +toPhysicalTableName(identifier: Identifier, env: JdbcEnvironment): Identifier
      +toPhysicalSequenceName(identifier: Identifier, env: JdbcEnvironment): Identifier
      +toPhysicalColumnName(identifier: Identifier, env: JdbcEnvironment): Identifier
      -toSnakeCase(identifier: Identifier): Identifier
      -toPlural(identifier: Identifier): Identifier
    }

    interface PhysicalNamingStrategy <<Hibernate>>
  }

  package "infrastructure.notifications" {
    interface NotificationSender {
      +send(notification: NotificationRequest): NotificationResult
    }

    class TwilioNotificationAssembler {
      -accountSid: String
      -authToken: String
      -fromNumber: String
      -restClient: RestClient
      +send(notification: NotificationRequest): NotificationResult
      -toTwilioMessage(notification: NotificationRequest): TwilioMessageResource
      -retry(notification: NotificationRequest, attempts: int): NotificationResult
    }

    class BrevoEmailNotificationAssembler {
      -mailSender: JavaMailSender
      -senderEmail: String
      +send(notification: NotificationRequest): NotificationResult
      -toMimeMessage(notification: NotificationRequest): MimeMessage
    }

    class NotificationRequest <<record>> {
      -recipient: String
      -channel: NotificationChannel
      -subject: String
      -message: String
    }

    class NotificationResult <<record>> {
      -messageId: String
      -delivered: boolean
    }

    enum NotificationChannel {
      SMS
      WHATSAPP
      EMAIL
    }
  }

  package "interfaces.rest" {
    class GlobalExceptionHandler <<RestControllerAdvice>> {
      +handleIllegalArgument(ex: IllegalArgumentException): ResponseEntity<ErrorResource>
      +handleNotFound(ex: EntityNotFoundException): ResponseEntity<ErrorResource>
      +handleValidation(ex: MethodArgumentNotValidException): ResponseEntity<ErrorResource>
    }

    class ErrorResource <<record>> {
      -status: int
      -message: String
      -timestamp: Date
    }
  }

  package "infrastructure.documentation.openapi.configuration" {
    class OpenApiConfiguration <<Configuration>> {
      -applicationName: String
      -applicationVersion: String
      +sumaqAgroOpenApi(): OpenAPI
    }
  }

  package "infrastructure.i18n" {
    class MessageSourceConfiguration <<Configuration>> {
      +messageSource(): MessageSource
      +localeResolver(): LocaleResolver
    }
  }
}

SnakeCaseWithPluralizedTablePhysicalNamingStrategy ..|> PhysicalNamingStrategy
TwilioNotificationAssembler ..|> NotificationSender
BrevoEmailNotificationAssembler ..|> NotificationSender
NotificationSender ..> NotificationRequest
NotificationSender ..> NotificationResult
NotificationRequest --> "1" NotificationChannel : "is sent through"
GlobalExceptionHandler ..> ErrorResource

note bottom of AuditableAbstractAggregateRoot
  Base class extended by every aggregate root
  of the six bounded contexts (Spring Data AbstractAggregateRoot
  with JPA auditing @CreatedDate / @LastModifiedDate).
end note

' --- vertical layout ---
NotificationSender -[hidden]down- BrevoEmailNotificationAssembler
TwilioNotificationAssembler -[hidden]down- NotificationRequest
BrevoEmailNotificationAssembler -[hidden]down- NotificationResult
NotificationRequest -[hidden]down- NotificationChannel
GlobalExceptionHandler -[hidden]down- SnakeCaseWithPluralizedTablePhysicalNamingStrategy
SnakeCaseWithPluralizedTablePhysicalNamingStrategy -[hidden]down- NotificationSender
NotificationResult -[hidden]down- OpenApiConfiguration
OpenApiConfiguration -[hidden]down- MessageSourceConfiguration
MessageSourceConfiguration -[hidden]down- AuditableAbstractAggregateRoot
AuditableAbstractAggregateRoot -[hidden]down- AuditableModel
AuditableModel -[hidden]down- EmailAddress

@enduml
