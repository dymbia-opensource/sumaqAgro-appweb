@startuml profiles-web-class-diagram
title Code View: SumaqAgro - Web Application - Profiles Component
caption Code diagram (C4 level 4) of the Profiles Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  interface BaseAssembler <<base-assembler.ts>>
  abstract class BaseApiEndpoint <<base-api-endpoint.ts>>
  abstract class BaseApi <<base-api.ts>>
}

package "src/app/iam" {
  class IamGuard <<iam.guard.ts>>
}

package "src/app/profiles" {
  package "domain/model" {
    package "entities" {
      class Profile <<profile.entity.ts>> {
        -_userId: number
        -_fullName: string
        -_phoneNumber: string
        -_photoUrl: string
        -_preferredLanguage: PreferredLanguage
        +get fullName(): string
        +get phoneNumber(): string
        +hasValidPhoneNumber(): boolean
      }

      class Cooperative <<cooperative.entity.ts>> {
        -_ruc: string
        -_businessName: string
        -_region: string
        -_managerUserId: number
        -_members: CooperativeMember[]
        +get members(): CooperativeMember[]
        +totalHectares(): number
        +findMemberByDni(dni: string): CooperativeMember | undefined
      }

      class CooperativeMember <<cooperative-member.entity.ts>> {
        -_cooperativeId: number
        -_dni: string
        -_fullName: string
        -_community: string
        -_plotCount: number
        -_hectares: number
        +get fullName(): string
      }

      class AgronomistInvitation <<agronomist-invitation.entity.ts>> {
        -_cooperativeId: number
        -_email: string
        -_status: InvitationStatus
        -_sentAt: Date
        +isPending(): boolean
      }

      class AgronomistAssignment <<agronomist-assignment.entity.ts>> {
        -_agronomistUserId: number
        -_plotId: number
        -_cooperativeId: number
        -_assignedAt: Date
        -_active: boolean
        +isActive(): boolean
      }

      enum PreferredLanguage {
        ES
        EN
      }

      enum InvitationStatus {
        PENDING
        ACCEPTED
        EXPIRED
      }
    }

    package "commands" {
      class UpdateProfileCommand <<update-profile.command.ts>> {
        +profileId: number
        +fullName: string
        +phoneNumber: string
        +photoUrl: string
      }
      class RegisterCooperativeCommand <<register-cooperative.command.ts>> {
        +ruc: string
        +businessName: string
        +region: string
      }
      class AddCooperativeMemberCommand <<add-cooperative-member.command.ts>> {
        +cooperativeId: number
        +dni: string
        +fullName: string
        +community: string
      }
      class InviteAgronomistCommand <<invite-agronomist.command.ts>> {
        +cooperativeId: number
        +email: string
      }
      class AssignAgronomistToPlotCommand <<assign-agronomist-to-plot.command.ts>> {
        +agronomistUserId: number
        +plotIds: number[]
      }
    }
  }

  package "application" {
    class ProfilesStore <<profiles.store.ts>> {
      -profileSignal: WritableSignal<Profile | null>
      -cooperativeSignal: WritableSignal<Cooperative | null>
      -membersSignal: WritableSignal<CooperativeMember[]>
      -assignmentsSignal: WritableSignal<AgronomistAssignment[]>
      +profile: Signal<Profile | null>
      +cooperative: Signal<Cooperative | null>
      +members: Signal<CooperativeMember[]>
      +assignments: Signal<AgronomistAssignment[]>
      +loadMyProfile(userId: number): void
      +updateProfile(command: UpdateProfileCommand): void
      +registerCooperative(command: RegisterCooperativeCommand): void
      +addMember(command: AddCooperativeMemberCommand): void
      +inviteAgronomist(command: InviteAgronomistCommand): void
      +assignAgronomist(command: AssignAgronomistToPlotCommand): void
      +filterMembers(term: string): CooperativeMember[]
    }
  }

  package "infrastructure" {
    class ProfilesApi <<profiles-api.ts>> {
      -profilesEndpoint: ProfilesApiEndpoint
      -cooperativesEndpoint: CooperativesApiEndpoint
      -membersEndpoint: CooperativeMembersApiEndpoint
      -assignmentsEndpoint: AgronomistAssignmentsApiEndpoint
      +getProfileByUserId(userId: number): Observable<Profile>
      +updateProfile(profile: Profile): Observable<Profile>
      +registerCooperative(cooperative: Cooperative): Observable<Cooperative>
      +getMembers(cooperativeId: number): Observable<CooperativeMember[]>
      +addMember(member: CooperativeMember): Observable<CooperativeMember>
      +inviteAgronomist(command: InviteAgronomistCommand): Observable<AgronomistInvitation>
      +createAssignment(assignment: AgronomistAssignment): Observable<AgronomistAssignment>
      +deleteAssignment(id: number): Observable<void>
    }

    package "endpoints" {
      class ProfilesApiEndpoint <<profiles.endpoint.ts>>
      class CooperativesApiEndpoint <<cooperatives.endpoint.ts>>
      class CooperativeMembersApiEndpoint <<cooperative-members.endpoint.ts>>
      class AgronomistAssignmentsApiEndpoint <<agronomist-assignments.endpoint.ts>>
    }

    package "assemblers" {
      class ProfileAssembler <<profile.assembler.ts>> {
        +toEntityFromResource(resource: ProfileResource): Profile
        +toResourceFromEntity(entity: Profile): ProfileResource
        +toEntitiesFromResponse(response: ProfilesResponse): Profile[]
      }
      class CooperativeAssembler <<cooperative.assembler.ts>> {
        +toEntityFromResource(resource: CooperativeResource): Cooperative
        +toResourceFromEntity(entity: Cooperative): CooperativeResource
        +toEntitiesFromResponse(response: CooperativesResponse): Cooperative[]
      }
      class CooperativeMemberAssembler <<cooperative-member.assembler.ts>> {
        +toEntityFromResource(resource: CooperativeMemberResource): CooperativeMember
        +toResourceFromEntity(entity: CooperativeMember): CooperativeMemberResource
        +toEntitiesFromResponse(response: CooperativeMembersResponse): CooperativeMember[]
      }
      class AgronomistAssignmentAssembler <<agronomist-assignment.assembler.ts>> {
        +toEntityFromResource(resource: AgronomistAssignmentResource): AgronomistAssignment
        +toResourceFromEntity(entity: AgronomistAssignment): AgronomistAssignmentResource
        +toEntitiesFromResponse(response: AgronomistAssignmentsResponse): AgronomistAssignment[]
      }
    }


    package "responses" {
      interface ProfileResource <<profile.response.ts>> {
        +id: number
        +userId: number
        +fullName: string
        +phoneNumber: string
        +photoUrl: string
        +preferredLanguage: string
      }
      interface CooperativeResource <<cooperative.response.ts>> {
        +id: number
        +ruc: string
        +businessName: string
        +region: string
        +managerUserId: number
      }
      interface CooperativeMemberResource <<cooperative-member.response.ts>> {
        +id: number
        +cooperativeId: number
        +dni: string
        +fullName: string
        +community: string
      }
      interface AgronomistAssignmentResource <<agronomist-assignment.response.ts>> {
        +id: number
        +agronomistUserId: number
        +plotId: number
        +cooperativeId: number
        +active: boolean
      }
      interface ProfilesResponse <<profiles.response.ts>> {
        +profiles: ProfileResource[]
      }
      interface CooperativesResponse <<cooperatives.response.ts>> {
        +cooperatives: CooperativeResource[]
      }
      interface CooperativeMembersResponse <<cooperative-members.response.ts>> {
        +members: CooperativeMemberResource[]
      }
      interface AgronomistAssignmentsResponse <<agronomist-assignments.response.ts>> {
        +assignments: AgronomistAssignmentResource[]
      }
    }
  }

  package "presentation/views" {
    class ProfileSettingsView <<profile-settings-view.ts>> {
      -profilesStore: ProfilesStore
      +form: FormGroup
      +onSave(): void
    }
    class CooperativeRegistrationForm <<cooperative-registration-form.ts>> {
      -profilesStore: ProfilesStore
      +form: FormGroup
      +onSubmit(): void
    }
    class MemberDirectoryView <<member-directory-view.ts>> {
      -profilesStore: ProfilesStore
      +searchTerm: string
      +onSearch(term: string): void
      +exportToCsv(): void
    }
    class AgronomistAssignmentView <<agronomist-assignment-view.ts>> {
      -profilesStore: ProfilesStore
      +selectedPlotIds: number[]
      +onAssign(agronomistUserId: number): void
    }
  }

  class ProfilesRoutes <<profiles.routes.ts>> {
    +routes: Routes
  }
}

ProfilesRoutes ..> IamGuard

