ProfilesApi "1" *-- "1" CooperativesApiEndpoint
ProfilesApi "1" *-- "1" CooperativeMembersApiEndpoint
ProfilesApi "1" *-- "1" AgronomistAssignmentsApiEndpoint
ProfilesApiEndpoint "1" --> "1" ProfileAssembler
CooperativesApiEndpoint "1" --> "1" CooperativeAssembler
CooperativeMembersApiEndpoint "1" --> "1" CooperativeMemberAssembler
