@startuml shared-web-class-diagram
title Code View: SumaqAgro - Web Application - Shared Component
caption Code diagram (C4 level 4) of the Shared Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
set separator none

package "src/app/iam" {
  class IamStore <<iam.store.ts>>
}

package "src/app/shared" {
  package "domain/model" {
    class BaseEntity <<base-entity.ts>> {
      #_id: number | string
      +constructor(props: {id: number | string})
      +get id(): number | string
      +set id(value: number | string)
    }

    class Money <<money.ts>> {
      -_amount: number
      -_currency: string
      +constructor(amount: number, currency: string)
      +get amount(): number
      +get currency(): string
      +add(other: Money): Money
      +multiply(factor: number): Money
      +format(): string
    }
  }

  package "infrastructure" {
    interface BaseResource <<base-response.ts>> {
      +id: number | string
    }

    interface BaseResponse <<base-response.ts>> {
    }

    interface "BaseAssembler<TEntity, TResource, TResponse>" as BaseAssembler <<base-assembler.ts>> {
      +toEntityFromResource(resource: TResource): TEntity
      +toResourceFromEntity(entity: TEntity): TResource
      +toEntitiesFromResponse(response: TResponse): TEntity[]
    }

    abstract class "BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>" as BaseApiEndpoint <<base-api-endpoint.ts>> {
      #http: HttpClient
      #endpointUrl: string
      #assembler: TAssembler
      #constructor(http: HttpClient, endpointUrl: string, assembler: TAssembler)
      +getAll(): Observable<TEntity[]>
      +getById(id: number): Observable<TEntity>
      +create(entity: TEntity): Observable<TEntity>
      +update(entity: TEntity, id: number): Observable<TEntity>
      +delete(id: number): Observable<void>
      #handleError(operation: string): (error: HttpErrorResponse) => Observable<never>
    }

    abstract class BaseApi <<base-api.ts>> {
    }

    abstract class ErrorHandlingEnabledBaseType <<error-handling-enabled-base-type.ts>> {
      #handleError(operation: string): (error: HttpErrorResponse) => Observable<never>
    }

    class OfflineSyncService <<offline-sync.service.ts>> {
      -db: Dexie
      -pendingCount: WritableSignal<number>
      +isOnline: Signal<boolean>
      +enqueue(operation: PendingOperation): Promise<void>
      +getPending(): Promise<PendingOperation[]>
      +flush(): Observable<SyncResult>
      -remove(uuid: string): Promise<void>
    }

    class PendingOperation <<pending-operation.ts>> {
      +uuid: string
      +type: PendingOperationType
      +payload: unknown
      +createdAt: Date
    }

    enum PendingOperationType {
      FIELD_EXPENSE
      PEST_REPORT
    }

    class AppUpdateService <<app-update.service.ts>> {
      -swUpdate: SwUpdate
      +checkForUpdate(): Promise<boolean>
      +activateUpdate(): Promise<void>
    }

    class SyncResult <<sync-result.ts>> {
      +synchronized: number
      +skippedDuplicates: number
      +failed: number
    }
  }

  package "presentation" {
    class Layout <<layout.ts>> {
      -iamStore: IamStore
      +options: NavigationOption[]
      +toggleSidebar(): void
    }

    class LanguageSwitcher <<language-switcher.ts>> {
      -translate: TranslateService
      +currentLang: string
      +languages: string[]
      +useLanguage(language: string): void
    }

    class OfflineStatusBanner <<offline-status-banner.ts>> {
      -offlineSyncService: OfflineSyncService
      +forceSynchronization(): void
    }

    class PageNotFound <<page-not-found.ts>> {
      +invalidPath: string
      +navigateToHome(): void
    }
  }
}

BaseApiEndpoint --|> BaseApi
BaseApi --|> ErrorHandlingEnabledBaseType
BaseAssembler ..> BaseEntity
BaseAssembler ..> BaseResource
BaseAssembler ..> BaseResponse
BaseApiEndpoint "1" o-- "1" BaseAssembler : "delegates mapping to"
BaseApiEndpoint ..> BaseEntity
OfflineSyncService "1" *-- "0..*" PendingOperation : "queues"
PendingOperation --> "1" PendingOperationType : "is of"
OfflineSyncService ..> SyncResult
Layout "1" *-- "1" LanguageSwitcher : "contains"
Layout "1" *-- "1" OfflineStatusBanner : "contains"
OfflineStatusBanner --> "1" OfflineSyncService : "observes"
Layout --> "1" AppUpdateService : "checks new versions with"
Layout --> "1" IamStore : "reads the role from"

@enduml
