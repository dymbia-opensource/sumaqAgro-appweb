@startuml field-management-web-class-diagram
title Code View: SumaqAgro - Web Application - Field Management Component
caption Code diagram (C4 level 4) of the Field Management Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  interface BaseAssembler <<base-assembler.ts>>
  abstract class BaseApiEndpoint <<base-api-endpoint.ts>>
  abstract class BaseApi <<base-api.ts>>
  class Money <<money.ts>>
  class OfflineSyncService <<offline-sync.service.ts>>
}

package "src/app/iam" {
  class IamGuard <<iam.guard.ts>>
}

package "src/app/field-management" {
  package "domain/model" {
    package "entities" {
      class FieldPlot <<field-plot.entity.ts>> {
        -_ownerUserId: number
        -_name: string
        -_region: string
        -_status: PlotStatus
        -_boundary: GeoCoordinate[]
        -_areaHectares: number
        -_agroMonitoringPolygonId: string | null
        -_soilBaseline: SoilBaseline | null
        +get name(): string
        +get areaHectares(): number
        +hasPolygon(): boolean
        +isMonitored(): boolean
      }

      class GeoCoordinate <<geo-coordinate.entity.ts>> {
        -_latitude: number
        -_longitude: number
        +get latitude(): number
        +get longitude(): number
      }

      class SoilBaseline <<soil-baseline.entity.ts>> {
        -_ph: number
        -_texture: string
        -_organicMatterPercentage: number
        -_recordedAt: Date
        +needsLiming(cropType: CropType): boolean
      }

      class CropCampaign <<crop-campaign.entity.ts>> {
        -_plotId: number
        -_season: string
        -_cropType: CropType
        -_seedVariety: string
        -_sowingDate: Date
        -_status: CampaignStatus
        +get cropType(): CropType
        +isActive(): boolean
      }

      class CampaignLedger <<campaign-ledger.entity.ts>> {
        -_campaignId: number
        -_entries: ExpenseEntry[]
        -_expectedYield: number
        -_actualYield: number | null
        -_yieldUnit: YieldUnit
        -_frozen: boolean
        +get entries(): ExpenseEntry[]
        +totalInvestment(): Money
        +totalByCategory(category: ExpenseCategory): Money
        +breakevenPrice(): Money
        +suggestedPrice(marginPercentage: number): Money
        +isFrozen(): boolean
      }

      class ExpenseEntry <<expense-entry.entity.ts>> {
        -_ledgerId: number
        -_category: ExpenseCategory
        -_description: string
        -_quantity: number
        -_unitPrice: Money
        -_expenseDate: Date
        -_notes: string
        -_clientSyncId: string
        +total(): Money
      }

      enum PlotStatus {
        WITHOUT_POLYGON
        ACTIVE_MONITORING
      }

      enum CropType {
        ANDEAN_POTATO
        SPECIALTY_COFFEE
      }

      enum CampaignStatus {
        IN_PROGRESS
        FINISHED
      }

      enum ExpenseCategory {
        INPUTS
        LABOR
        FREIGHT
      }

      enum YieldUnit {
        SACK
        QUINTAL
      }
    }

    package "commands" {
      class RegisterFieldPlotCommand <<register-field-plot.command.ts>> {
        +name: string
        +region: string
      }
      class DelineatePlotBoundaryCommand <<delineate-plot-boundary.command.ts>> {
        +plotId: number
        +coordinates: GeoCoordinate[]
      }
      class RecordSoilBaselineCommand <<record-soil-baseline.command.ts>> {
        +plotId: number
        +ph: number
        +texture: string
        +organicMatterPercentage: number
      }
      class StartCropCampaignCommand <<start-crop-campaign.command.ts>> {
        +plotId: number
        +season: string
      }
      class SelectCropTypeCommand <<select-crop-type.command.ts>> {
        +campaignId: number
        +cropType: CropType
      }
      class SpecifySeedVarietyCommand <<specify-seed-variety.command.ts>> {
        +campaignId: number
        +varietyName: string
        +custom: boolean
      }
      class RecordSowingDateCommand <<record-sowing-date.command.ts>> {
        +campaignId: number
        +sowingDate: Date
      }
      class CloseCropCampaignCommand <<close-crop-campaign.command.ts>> {
        +campaignId: number
      }
      class RecordInputExpenseCommand <<record-input-expense.command.ts>> {
        +ledgerId: number
        +inputName: string
        +quantity: number
        +unitPrice: number
        +expenseDate: Date
      }
      class RecordDailyLaborExpenseCommand <<record-daily-labor-expense.command.ts>> {
        +ledgerId: number
        +workers: number
        +days: number
        +dailyWage: number
        +expenseDate: Date
      }
      class RecordFieldFreightExpenseCommand <<record-field-freight-expense.command.ts>> {
        +ledgerId: number
        +route: string
        +cost: number
        +expenseDate: Date
      }
      class SetExpectedYieldCommand <<set-expected-yield.command.ts>> {
        +ledgerId: number
        +expectedYield: number
        +unit: YieldUnit
      }
      class ExportCampaignCostReportCommand <<export-campaign-cost-report.command.ts>> {
        +campaignId: number
      }
    }
  }

  package "application" {
    class FieldManagementStore <<field-management.store.ts>> {
      -plotsSignal: WritableSignal<FieldPlot[]>
      -selectedPlotIdSignal: WritableSignal<number | null>
      -campaignsSignal: WritableSignal<CropCampaign[]>
      -ledgerSignal: WritableSignal<CampaignLedger | null>
      -offlineSyncService: OfflineSyncService
      +plots: Signal<FieldPlot[]>
      +selectedPlot: Signal<FieldPlot | undefined>
      +activeCampaign: Signal<CropCampaign | undefined>
      +ledger: Signal<CampaignLedger | null>
      +loadMyPlots(ownerUserId: number): void
      +selectPlot(plotId: number): void
      +registerPlot(command: RegisterFieldPlotCommand): void
      +delineateBoundary(command: DelineatePlotBoundaryCommand): void
      +recordSoilBaseline(command: RecordSoilBaselineCommand): void
      +startCampaign(command: StartCropCampaignCommand): void
      +selectCropType(command: SelectCropTypeCommand): void
      +specifySeedVariety(command: SpecifySeedVarietyCommand): void
      +recordSowingDate(command: RecordSowingDateCommand): void
      +closeCampaign(command: CloseCropCampaignCommand): void
      +recordInputExpense(command: RecordInputExpenseCommand): void
      +recordDailyLaborExpense(command: RecordDailyLaborExpenseCommand): void
      +recordFieldFreightExpense(command: RecordFieldFreightExpenseCommand): void
      +setExpectedYield(command: SetExpectedYieldCommand): void
      +exportCostReport(command: ExportCampaignCostReportCommand): void
    }
  }

  package "infrastructure" {
    class FieldManagementApi <<field-management-api.ts>> {
      -plotsEndpoint: FieldPlotsApiEndpoint
      -campaignsEndpoint: CropCampaignsApiEndpoint
      -ledgersEndpoint: CampaignLedgersApiEndpoint
      +getPlotsByOwner(ownerUserId: number): Observable<FieldPlot[]>
      +createPlot(plot: FieldPlot): Observable<FieldPlot>
      +updateBoundary(plotId: number, coordinates: GeoCoordinate[]): Observable<FieldPlot>
      +createCampaign(campaign: CropCampaign): Observable<CropCampaign>
      +updateCampaign(campaign: CropCampaign): Observable<CropCampaign>
      +closeCampaign(campaignId: number): Observable<CropCampaign>
      +getLedgerByCampaign(campaignId: number): Observable<CampaignLedger>
      +addExpense(ledgerId: number, entry: ExpenseEntry): Observable<CampaignLedger>
      +updateExpectedYield(ledger: CampaignLedger): Observable<CampaignLedger>
      +syncExpenses(entries: ExpenseEntry[]): Observable<SyncResult>
      +downloadCostReport(campaignId: number): Observable<Blob>
    }

    package "endpoints" {
      class FieldPlotsApiEndpoint <<field-plots.endpoint.ts>>
      class CropCampaignsApiEndpoint <<crop-campaigns.endpoint.ts>>
      class CampaignLedgersApiEndpoint <<campaign-ledgers.endpoint.ts>>
    }

    package "assemblers" {
      class FieldPlotAssembler <<field-plot.assembler.ts>> {
        +toEntityFromResource(resource: FieldPlotResource): FieldPlot
        +toResourceFromEntity(entity: FieldPlot): FieldPlotResource
        +toEntitiesFromResponse(response: FieldPlotsResponse): FieldPlot[]
      }
      class CropCampaignAssembler <<crop-campaign.assembler.ts>> {
        +toEntityFromResource(resource: CropCampaignResource): CropCampaign
        +toResourceFromEntity(entity: CropCampaign): CropCampaignResource
        +toEntitiesFromResponse(response: CropCampaignsResponse): CropCampaign[]
      }
      class CampaignLedgerAssembler <<campaign-ledger.assembler.ts>> {
        +toEntityFromResource(resource: CampaignLedgerResource): CampaignLedger
        +toResourceFromEntity(entity: CampaignLedger): CampaignLedgerResource
        +toEntitiesFromResponse(response: CampaignLedgersResponse): CampaignLedger[]
        +toExpenseResource(entry: ExpenseEntry): ExpenseEntryResource
      }
    }


    package "responses" {
      interface FieldPlotResource <<field-plot.response.ts>> {
        +id: number
        +ownerUserId: number
        +name: string
        +region: string
        +status: string
        +boundary: number[][]
        +areaHectares: number
        +agroMonitoringPolygonId: string
      }
      interface CropCampaignResource <<crop-campaign.response.ts>> {
        +id: number
        +plotId: number
        +cropType: string
        +seedVariety: string
        +sowingDate: string
        +status: string
      }
      interface CampaignLedgerResource <<campaign-ledger.response.ts>> {
        +id: number
        +campaignId: number
        +expectedYield: number
        +actualYield: number
        +yieldUnit: string
        +entries: ExpenseEntryResource[]
      }
      interface ExpenseEntryResource <<expense-entry.response.ts>> {
        +id: number
        +category: string
        +description: string
        +quantity: number
        +unitPrice: number
        +expenseDate: string
        +clientSyncId: string
      }
      interface FieldPlotsResponse <<field-plots.response.ts>> {
        +plots: FieldPlotResource[]
      }
      interface CropCampaignsResponse <<crop-campaigns.response.ts>> {
        +campaigns: CropCampaignResource[]
      }
      interface CampaignLedgersResponse <<campaign-ledgers.response.ts>> {
        +ledgers: CampaignLedgerResource[]
      }
    }
  }

  package "presentation/views" {
    class MyPlotDashboardView <<my-plot-dashboard-view.ts>> {
      -fieldManagementStore: FieldManagementStore
      +onViewSatelliteMap(): void
      +onViewExpenses(): void
    }
    class RegisteredPlotsView <<registered-plots-view.ts>> {
      -fieldManagementStore: FieldManagementStore
      +onRegisterNewPlot(): void
      +onSelectPlot(plotId: number): void
    }
    class PlotRegistrationForm <<plot-registration-form.ts>> {
      -fieldManagementStore: FieldManagementStore
      +form: FormGroup
      +onNext(): void
    }
    class PlotBoundaryMapView <<plot-boundary-map-view.ts>> {
      -map: L.Map
      -fieldManagementStore: FieldManagementStore
      +markedCoordinates: GeoCoordinate[]
      +onAddVertex(coordinate: GeoCoordinate): void
      +onSavePlot(): void
    }
    class CampaignFinancesView <<campaign-finances-view.ts>> {
      -fieldManagementStore: FieldManagementStore
      +categoryFilter: ExpenseCategory | null
      +onExport(): void
    }
    class FieldExpenseForm <<field-expense-form.ts>> {
      -fieldManagementStore: FieldManagementStore
      +form: FormGroup
      +onSaveExpense(): void
    }
  }

  class FieldManagementRoutes <<field-management.routes.ts>> {
    +routes: Routes
  }
}

FieldManagementRoutes ..> IamGuard

FieldPlot --|> BaseEntity
CropCampaign --|> BaseEntity
CampaignLedger --|> BaseEntity
ExpenseEntry --|> BaseEntity
FieldPlotResource --|> BaseResource
CropCampaignResource --|> BaseResource
CampaignLedgerResource --|> BaseResource
ExpenseEntryResource --|> BaseResource
FieldPlotsResponse --|> BaseResponse
CropCampaignsResponse --|> BaseResponse
CampaignLedgersResponse --|> BaseResponse
FieldPlotAssembler ..|> BaseAssembler
CropCampaignAssembler ..|> BaseAssembler
CampaignLedgerAssembler ..|> BaseAssembler
FieldPlotsApiEndpoint --|> BaseApiEndpoint
CropCampaignsApiEndpoint --|> BaseApiEndpoint
CampaignLedgersApiEndpoint --|> BaseApiEndpoint
FieldManagementApi --|> BaseApi

FieldPlot "1" *-- "3..*" GeoCoordinate : "is bounded by"
FieldPlot "1" *-- "0..1" SoilBaseline : "has"
FieldPlot --> "1" PlotStatus : "has"
FieldPlot "1" --> "0..*" CropCampaign : "hosts"
CropCampaign --> "1" CropType : "grows"
CropCampaign --> "1" CampaignStatus : "has"
CropCampaign "1" --> "1" CampaignLedger : "is costed by"
CampaignLedger "1" *-- "0..*" ExpenseEntry : "records"
CampaignLedger --> "1" YieldUnit : "measures yield in"
ExpenseEntry --> "1" ExpenseCategory : "belongs to"
ExpenseEntry --> "1" Money

FieldManagementStore "1" --> "1" FieldManagementApi
FieldManagementStore "1" --> "1" OfflineSyncService
FieldManagementStore "1" o-- "0..*" FieldPlot
FieldManagementStore "1" o-- "0..1" CampaignLedger
FieldManagementApi "1" *-- "1" FieldPlotsApiEndpoint
FieldManagementApi "1" *-- "1" CropCampaignsApiEndpoint
FieldManagementApi "1" *-- "1" CampaignLedgersApiEndpoint
FieldPlotsApiEndpoint "1" --> "1" FieldPlotAssembler
CropCampaignsApiEndpoint "1" --> "1" CropCampaignAssembler
CampaignLedgersApiEndpoint "1" --> "1" CampaignLedgerAssembler

PlotRegistrationForm ..> RegisterFieldPlotCommand
PlotRegistrationForm ..> StartCropCampaignCommand
PlotRegistrationForm ..> SelectCropTypeCommand
PlotRegistrationForm ..> SpecifySeedVarietyCommand
PlotRegistrationForm ..> RecordSowingDateCommand
PlotBoundaryMapView ..> DelineatePlotBoundaryCommand
FieldExpenseForm ..> RecordInputExpenseCommand
FieldExpenseForm ..> RecordDailyLaborExpenseCommand
FieldExpenseForm ..> RecordFieldFreightExpenseCommand
CampaignFinancesView ..> SetExpectedYieldCommand
CampaignFinancesView ..> ExportCampaignCostReportCommand
MyPlotDashboardView --> "1" FieldManagementStore
RegisteredPlotsView --> "1" FieldManagementStore
PlotRegistrationForm --> "1" FieldManagementStore
PlotBoundaryMapView --> "1" FieldManagementStore
CampaignFinancesView --> "1" FieldManagementStore
FieldExpenseForm --> "1" FieldManagementStore

