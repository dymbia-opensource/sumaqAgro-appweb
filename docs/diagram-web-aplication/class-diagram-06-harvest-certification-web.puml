@startuml harvest-certification-web-class-diagram
title Code View: SumaqAgro - Web Application - Harvest Certification Component
caption Code diagram (C4 level 4) of the Harvest Certification Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  interface BaseAssembler <<base-assembler.ts>>
  abstract class BaseApiEndpoint <<base-api-endpoint.ts>>
  abstract class BaseApi <<base-api.ts>>
}

package "src/app/iam" {
  class IamGuard <<iam.guard.ts>>
}

package "src/app/harvest-certification" {
  package "domain/model" {
    package "entities" {
      class HarvestBatch <<harvest-batch.entity.ts>> {
        -_code: string
        -_cooperativeId: number
        -_memberId: number
        -_plotId: number
        -_campaignId: number
        -_cropType: CropType
        -_collectedAt: Date
        -_grossWeightKg: number
        -_tareKg: number
        -_status: BatchStatus
        -_sample: RepresentativeSample | null
        -_potatoGrading: PotatoCaliberGrading | null
        -_cuppingResult: CoffeeCuppingResult | null
        -_qualityCategory: QualityCategory | null
        +get code(): string
        +netWeightKg(): number
        +isReadyForCertification(): boolean
      }

      class RepresentativeSample <<representative-sample.entity.ts>> {
        -_weightKg: number
        -_extractedAt: Date
        +isSufficientFor(cropType: CropType): boolean
      }

      class PotatoCaliberGrading <<potato-caliber-grading.entity.ts>> {
        -_firstPercentage: number
        -_secondPercentage: number
        -_thirdPercentage: number
        -_weevilDamagePercentage: number
        +meetsCommercialStandard(): boolean
      }

      class CoffeeCuppingResult <<coffee-cupping-result.entity.ts>> {
        -_aroma: number
        -_flavor: number
        -_acidity: number
        -_body: number
        -_totalScore: number
        +isSpecialty(): boolean
      }

      class QualityCertificate <<quality-certificate.entity.ts>> {
        -_batchId: number
        -_certificateNumber: string
        -_hashSha256: string
        -_issuedAt: Date
        -_issuedBy: string
        -_qrCodeUrl: string
        -_status: CertificateStatus
        +isValid(): boolean
      }

      class PublicTraceabilityRecord <<public-traceability-record.entity.ts>> {
        -_certificateNumber: string
        -_originPlotName: string
        -_originRegion: string
        -_seedVariety: string
        -_qualityCategory: QualityCategory
        -_valid: boolean
      }

      enum CropType {
        ANDEAN_POTATO
        SPECIALTY_COFFEE
      }
      enum BatchStatus {
        PENDING_GRADING
        GRADED
        CERTIFIED
      }
      enum QualityCategory {
        PREMIUM_GOLD
        STANDARD
        B_GRADE_REQUIRES_SORTING
        COMMERCIAL_COFFEE
      }
      enum CertificateStatus {
        ACTIVE
        REVOKED
      }
    }

    package "commands" {
      class RegisterHarvestBatchCommand <<register-harvest-batch.command.ts>> {
        +memberId: number
        +plotId: number
        +campaignId: number
        +collectedAt: Date
      }
      class WeighDeliveredBatchCommand <<weigh-delivered-batch.command.ts>> {
        +batchId: number
        +grossWeightKg: number
        +sackCount: number
        +tarePerSackKg: number
      }
      class ExtractRepresentativeSampleCommand <<extract-representative-sample.command.ts>> {
        +batchId: number
        +weightKg: number
      }
      class GradePotatoCalibersCommand <<grade-potato-calibers.command.ts>> {
        +batchId: number
        +firstPercentage: number
        +secondPercentage: number
        +thirdPercentage: number
        +weevilDamagePercentage: number
      }
      class PerformCoffeeCuppingCommand <<perform-coffee-cupping.command.ts>> {
        +batchId: number
        +aroma: number
        +flavor: number
        +acidity: number
        +body: number
      }
      class IssueQualityCertificateCommand <<issue-quality-certificate.command.ts>> {
        +batchId: number
      }
      class VerifyCertificateCommand <<verify-certificate.command.ts>> {
        +certificateNumber: string
        +hash: string
      }
    }
  }

  package "application" {
    class HarvestCertificationStore <<harvest-certification.store.ts>> {
      -batchesSignal: WritableSignal<HarvestBatch[]>
      -certificatesSignal: WritableSignal<QualityCertificate[]>
      -traceabilitySignal: WritableSignal<PublicTraceabilityRecord | null>
      +batches: Signal<HarvestBatch[]>
      +certificates: Signal<QualityCertificate[]>
      +traceability: Signal<PublicTraceabilityRecord | null>
      +loadBatches(cooperativeId: number): void
      +loadMyCertificates(farmerUserId: number): void
      +registerBatch(command: RegisterHarvestBatchCommand): void
      +weighBatch(command: WeighDeliveredBatchCommand): void
      +extractSample(command: ExtractRepresentativeSampleCommand): void
      +gradePotatoCalibers(command: GradePotatoCalibersCommand): void
      +performCoffeeCupping(command: PerformCoffeeCuppingCommand): void
      +issueCertificate(command: IssueQualityCertificateCommand): void
      +downloadCertificatePdf(certificateId: number): void
      +verifyCertificate(command: VerifyCertificateCommand): void
    }
  }

  package "infrastructure" {
    class HarvestCertificationApi <<harvest-certification-api.ts>> {
      -batchesEndpoint: HarvestBatchesApiEndpoint
      -certificatesEndpoint: QualityCertificatesApiEndpoint
      -traceabilityEndpoint: PublicTraceabilityApiEndpoint
      +getBatchesByCooperative(cooperativeId: number): Observable<HarvestBatch[]>
      +createBatch(batch: HarvestBatch): Observable<HarvestBatch>
      +updateBatch(batch: HarvestBatch): Observable<HarvestBatch>
      +issueCertificate(batchId: number): Observable<QualityCertificate>
      +downloadPdf(certificateId: number): Observable<Blob>
      +verify(command: VerifyCertificateCommand): Observable<PublicTraceabilityRecord>
    }

    package "endpoints" {
      class HarvestBatchesApiEndpoint <<harvest-batches.endpoint.ts>>
      class QualityCertificatesApiEndpoint <<quality-certificates.endpoint.ts>>
      class PublicTraceabilityApiEndpoint <<public-traceability.endpoint.ts>> {
        -http: HttpClient
        -assembler: PublicTraceabilityAssembler
        +verify(command: VerifyCertificateCommand): Observable<PublicTraceabilityRecord>
      }
    }

    package "assemblers" {
      class HarvestBatchAssembler <<harvest-batch.assembler.ts>> {
        +toEntityFromResource(resource: HarvestBatchResource): HarvestBatch
        +toResourceFromEntity(entity: HarvestBatch): HarvestBatchResource
        +toEntitiesFromResponse(response: HarvestBatchesResponse): HarvestBatch[]
      }
      class QualityCertificateAssembler <<quality-certificate.assembler.ts>> {
        +toEntityFromResource(resource: QualityCertificateResource): QualityCertificate
        +toResourceFromEntity(entity: QualityCertificate): QualityCertificateResource
        +toEntitiesFromResponse(response: QualityCertificatesResponse): QualityCertificate[]
      }
      class PublicTraceabilityAssembler <<public-traceability.assembler.ts>> {
        +toEntityFromResponse(response: PublicTraceabilityResponse): PublicTraceabilityRecord
      }
    }


    package "responses" {
      interface HarvestBatchResource <<harvest-batch.response.ts>> {
        +id: number
        +code: string
        +memberId: number
        +plotId: number
        +cropType: string
        +grossWeightKg: number
        +tareKg: number
        +status: string
        +qualityCategory: string
      }
      interface QualityCertificateResource <<quality-certificate.response.ts>> {
        +id: number
        +batchId: number
        +certificateNumber: string
        +hashSha256: string
        +issuedAt: string
        +qrCodeUrl: string
        +status: string
      }
      interface HarvestBatchesResponse <<harvest-batches.response.ts>> {
        +batches: HarvestBatchResource[]
      }
      interface QualityCertificatesResponse <<quality-certificates.response.ts>> {
        +certificates: QualityCertificateResource[]
      }
      interface PublicTraceabilityResponse <<public-traceability.response.ts>> {
        +certificateNumber: string
        +originPlotName: string
        +originRegion: string
        +seedVariety: string
        +qualityCategory: string
        +valid: boolean
      }
    }
  }

  package "presentation/views" {
    class HarvestCertificatesView <<harvest-certificates-view.ts>> {
      -harvestCertificationStore: HarvestCertificationStore
      +onDownloadPdf(certificateId: number): void
      +onShowQrCode(certificateId: number): void
    }
    class HarvestBatchRegistrationView <<harvest-batch-registration-view.ts>> {
      -harvestCertificationStore: HarvestCertificationStore
      +form: FormGroup
      +onRegister(): void
      +onWeigh(): void
    }
    class HarvestGradingSheetView <<harvest-grading-sheet-view.ts>> {
      -harvestCertificationStore: HarvestCertificationStore
      +form: FormGroup
      +onGradePotato(): void
      +onCoffeeCupping(): void
      +onIssueCertificate(): void
    }
    class PublicTraceabilityView <<public-traceability-view.ts>> {
      -harvestCertificationStore: HarvestCertificationStore
      +certificateNumber: string
      +ngOnInit(): void
    }
  }

  class HarvestCertificationRoutes <<harvest-certification.routes.ts>> {
    +routes: Routes
  }
}

HarvestCertificationRoutes ..> IamGuard

