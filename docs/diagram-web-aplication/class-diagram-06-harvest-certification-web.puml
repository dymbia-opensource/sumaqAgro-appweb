HarvestCertificationApi "1" *-- "1" QualityCertificatesApiEndpoint
HarvestCertificationApi "1" *-- "1" PublicTraceabilityApiEndpoint
HarvestBatchesApiEndpoint "1" --> "1" HarvestBatchAssembler
QualityCertificatesApiEndpoint "1" --> "1" QualityCertificateAssembler
PublicTraceabilityApiEndpoint "1" --> "1" PublicTraceabilityAssembler

HarvestBatchRegistrationView ..> RegisterHarvestBatchCommand
HarvestBatchRegistrationView ..> WeighDeliveredBatchCommand
