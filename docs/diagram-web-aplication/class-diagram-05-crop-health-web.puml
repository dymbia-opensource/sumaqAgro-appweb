@startuml crop-health-web-class-diagram
title Code View: SumaqAgro - Web Application - Crop Health Component
caption Code diagram (C4 level 4) of the Crop Health Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  interface BaseAssembler <<base-assembler.ts>>
  abstract class BaseApiEndpoint <<base-api-endpoint.ts>>
  abstract class BaseApi <<base-api.ts>>
  class OfflineSyncService <<offline-sync.service.ts>>
}

package "src/app/iam" {
  class IamGuard <<iam.guard.ts>>
}

package "src/app/crop-health" {
  package "domain/model" {
    package "entities" {
      class SatelliteObservation <<satellite-observation.entity.ts>> {
        -_plotId: number
        -_capturedAt: Date
        -_source: SatelliteSource
        -_cloudCoverage: number
        -_ndvi: number
        -_ndwi: number
        -_discarded: boolean
        +get ndvi(): number
        +get ndwi(): number
        +isUsable(): boolean
        +vigorLevel(): string
      }

      class ClimateForecast <<climate-forecast.entity.ts>> {
        -_plotId: number
        -_forecastDate: Date
        -_minTemperature: number
        -_maxTemperature: number
        -_precipitationMm: number
        +hasFrostRisk(): boolean
      }

      class AgroclimaticAlert <<agroclimatic-alert.entity.ts>> {
        -_plotId: number
        -_type: AlertType
        -_severity: AlertSeverity
        -_status: AlertStatus
        -_raisedAt: Date
        -_actionSteps: ActionStep[]
        +get actionSteps(): ActionStep[]
        +progress(): number
        +isCritical(): boolean
      }

      class ActionStep <<action-step.entity.ts>> {
        -_description: string
        -_scheduledAt: Date
        -_completed: boolean
        +isCompleted(): boolean
      }

      class RegionalBulletin <<regional-bulletin.entity.ts>> {
        -_agronomistUserId: number
        -_region: string
        -_title: string
        -_preventiveMeasures: string
        -_issuedAt: Date
      }

      class PestReport <<pest-report.entity.ts>> {
        -_plotId: number
        -_farmerUserId: number
        -_assignedAgronomistUserId: number
        -_photoUrl: string
        -_comments: string
        -_damageAssessment: string
        -_status: PestReportStatus
        -_createdAt: Date
        +isOpen(): boolean
      }

      class FieldInspection <<field-inspection.entity.ts>> {
        -_pestReportId: number
        -_agronomistUserId: number
        -_scheduledAt: Date
        -_completedAt: Date | null
        -_findings: string
        -_status: InspectionStatus
        +isPending(): boolean
      }

      class TechnicalPrescription <<technical-prescription.entity.ts>> {
        -_pestReportId: number
        -_agronomistUserId: number
        -_product: string
        -_dosage: string
        -_frequency: string
        -_waitingPeriodDays: number
        -_status: PrescriptionStatus
        -_issuedAt: Date
        +isPendingApplication(): boolean
      }

      enum SatelliteSource {
        SENTINEL_2
        LANDSAT_8
      }
      enum AlertType {
        VEGETATION_ANOMALY
        WATER_STRESS
        FROST_RISK
      }
      enum AlertSeverity {
        LOW
        MEDIUM
        CRITICAL
      }
      enum AlertStatus {
        ACTIVE
        MITIGATED
      }
      enum PestReportStatus {
        SUBMITTED
        UNDER_REVIEW
        PRESCRIBED
        IN_FOLLOW_UP
        RESOLVED
        REOPENED
      }
      enum InspectionStatus {
        SCHEDULED
        COMPLETED
      }
      enum PrescriptionStatus {
        PENDING_APPLICATION
        APPLIED
        EVALUATED
      }
    }

    package "commands" {
      class UploadPestEvidencePhotoCommand <<upload-pest-evidence-photo.command.ts>> {
        +plotId: number
        +photo: File
        +comments: string
        +clientSyncId: string
      }
      class RecordDamageAssessmentCommand <<record-damage-assessment.command.ts>> {
        +pestReportId: number
        +assessment: string
      }
      class ScheduleFieldInspectionCommand <<schedule-field-inspection.command.ts>> {
        +pestReportId: number
        +scheduledAt: Date
      }
      class CompleteFieldInspectionCommand <<complete-field-inspection.command.ts>> {
        +inspectionId: number
        +findings: string
      }
      class IssueTechnicalPrescriptionCommand <<issue-technical-prescription.command.ts>> {
        +pestReportId: number
        +product: string
        +dosage: string
        +frequency: string
        +waitingPeriodDays: number
      }
      class ConfirmTreatmentApplicationCommand <<confirm-treatment-application.command.ts>> {
        +prescriptionId: number
      }
      class ReportFoliageRecoveryCommand <<report-foliage-recovery.command.ts>> {
        +prescriptionId: number
        +pestPersists: boolean
      }
      class EvaluateTreatmentEffectivenessCommand <<evaluate-treatment-effectiveness.command.ts>> {
        +prescriptionId: number
        +effective: boolean
      }
      class CompleteActionStepCommand <<complete-action-step.command.ts>> {
        +alertId: number
        +actionStepId: number
      }
      class CloseAlertCommand <<close-alert.command.ts>> {
        +alertId: number
      }
      class IssueRegionalBulletinCommand <<issue-regional-bulletin.command.ts>> {
        +region: string
        +title: string
        +preventiveMeasures: string
      }
    }
  }

  package "application" {
    class CropHealthStore <<crop-health.store.ts>> {
      -observationsSignal: WritableSignal<SatelliteObservation[]>
      -forecastsSignal: WritableSignal<ClimateForecast[]>
      -alertsSignal: WritableSignal<AgroclimaticAlert[]>
      -bulletinsSignal: WritableSignal<RegionalBulletin[]>
      -pestReportsSignal: WritableSignal<PestReport[]>
      -prescriptionsSignal: WritableSignal<TechnicalPrescription[]>
      -offlineSyncService: OfflineSyncService
      +latestObservation: Signal<SatelliteObservation | undefined>
      +activeAlerts: Signal<AgroclimaticAlert[]>
      +activePrescription: Signal<TechnicalPrescription | undefined>
      +loadPlotHealth(plotId: number): void
      +loadAlerts(plotId: number): void
      +completeActionStep(command: CompleteActionStepCommand): void
      +closeAlert(command: CloseAlertCommand): void
      +uploadPestReport(command: UploadPestEvidencePhotoCommand): void
      +recordDamageAssessment(command: RecordDamageAssessmentCommand): void
      +scheduleInspection(command: ScheduleFieldInspectionCommand): void
      +completeInspection(command: CompleteFieldInspectionCommand): void
      +issuePrescription(command: IssueTechnicalPrescriptionCommand): void
      +confirmTreatment(command: ConfirmTreatmentApplicationCommand): void
      +reportFoliageRecovery(command: ReportFoliageRecoveryCommand): void
      +evaluateTreatmentEffectiveness(command: EvaluateTreatmentEffectivenessCommand): void
      +issueBulletin(command: IssueRegionalBulletinCommand): void
    }
  }

  package "infrastructure" {
    class CropHealthApi <<crop-health-api.ts>> {
      -observationsEndpoint: SatelliteObservationsApiEndpoint
      -forecastsEndpoint: ClimateForecastsApiEndpoint
      -alertsEndpoint: AgroclimaticAlertsApiEndpoint
      -bulletinsEndpoint: RegionalBulletinsApiEndpoint
      -pestReportsEndpoint: PestReportsApiEndpoint
      -inspectionsEndpoint: FieldInspectionsApiEndpoint
      -prescriptionsEndpoint: TechnicalPrescriptionsApiEndpoint
      +getObservationsByPlot(plotId: number): Observable<SatelliteObservation[]>
      +getForecastByPlot(plotId: number): Observable<ClimateForecast[]>
      +getAlertsByPlot(plotId: number): Observable<AgroclimaticAlert[]>
      +createPestReport(report: PestReport, photo: File): Observable<PestReport>
      +createPrescription(prescription: TechnicalPrescription): Observable<TechnicalPrescription>
    }

    package "endpoints" {
      class SatelliteObservationsApiEndpoint <<satellite-observations.endpoint.ts>>
      class ClimateForecastsApiEndpoint <<climate-forecasts.endpoint.ts>>
      class AgroclimaticAlertsApiEndpoint <<agroclimatic-alerts.endpoint.ts>>
      class RegionalBulletinsApiEndpoint <<regional-bulletins.endpoint.ts>>
      class PestReportsApiEndpoint <<pest-reports.endpoint.ts>>
      class FieldInspectionsApiEndpoint <<field-inspections.endpoint.ts>>
      class TechnicalPrescriptionsApiEndpoint <<technical-prescriptions.endpoint.ts>>
    }

    package "assemblers" {
      class SatelliteObservationAssembler <<satellite-observation.assembler.ts>> {
        +toEntityFromResource(resource: SatelliteObservationResource): SatelliteObservation
        +toEntitiesFromResponse(response: SatelliteObservationsResponse): SatelliteObservation[]
      }
      class ClimateForecastAssembler <<climate-forecast.assembler.ts>> {
        +toEntityFromResource(resource: ClimateForecastResource): ClimateForecast
        +toEntitiesFromResponse(response: ClimateForecastsResponse): ClimateForecast[]
      }
      class AgroclimaticAlertAssembler <<agroclimatic-alert.assembler.ts>> {
        +toEntityFromResource(resource: AgroclimaticAlertResource): AgroclimaticAlert
        +toEntitiesFromResponse(response: AgroclimaticAlertsResponse): AgroclimaticAlert[]
      }
      class RegionalBulletinAssembler <<regional-bulletin.assembler.ts>> {
        +toEntityFromResource(resource: RegionalBulletinResource): RegionalBulletin
        +toResourceFromEntity(entity: RegionalBulletin): RegionalBulletinResource
      }
      class PestReportAssembler <<pest-report.assembler.ts>> {
        +toEntityFromResource(resource: PestReportResource): PestReport
        +toResourceFromEntity(entity: PestReport): PestReportResource
      }
      class FieldInspectionAssembler <<field-inspection.assembler.ts>> {
        +toEntityFromResource(resource: FieldInspectionResource): FieldInspection
        +toResourceFromEntity(entity: FieldInspection): FieldInspectionResource
      }
      class TechnicalPrescriptionAssembler <<technical-prescription.assembler.ts>> {
        +toEntityFromResource(resource: TechnicalPrescriptionResource): TechnicalPrescription
        +toResourceFromEntity(entity: TechnicalPrescription): TechnicalPrescriptionResource
      }
    }


    package "responses" {
      interface SatelliteObservationResource <<satellite-observation.response.ts>> {
        +id: number
        +plotId: number
        +capturedAt: string
        +source: string
        +cloudCoverage: number
        +ndvi: number
        +ndwi: number
      }
      interface ClimateForecastResource <<climate-forecast.response.ts>> {
        +id: number
        +plotId: number
        +forecastDate: string
        +minTemperature: number
        +maxTemperature: number
      }
      interface AgroclimaticAlertResource <<agroclimatic-alert.response.ts>> {
        +id: number
        +plotId: number
        +type: string
        +severity: string
        +status: string
      }
      interface RegionalBulletinResource <<regional-bulletin.response.ts>>
      interface PestReportResource <<pest-report.response.ts>> {
        +id: number
        +plotId: number
        +photoUrl: string
        +comments: string
        +status: string
      }
      interface FieldInspectionResource <<field-inspection.response.ts>>
      interface TechnicalPrescriptionResource <<technical-prescription.response.ts>> {
        +id: number
        +pestReportId: number
        +product: string
        +dosage: string
        +status: string
      }
      interface SatelliteObservationsResponse <<satellite-observations.response.ts>> {
        +observations: SatelliteObservationResource[]
      }
      interface ClimateForecastsResponse <<climate-forecasts.response.ts>> {
        +forecasts: ClimateForecastResource[]
      }
      interface AgroclimaticAlertsResponse <<agroclimatic-alerts.response.ts>> {
        +alerts: AgroclimaticAlertResource[]
      }
    }
  }

  package "presentation/views" {
    class CropHealthView <<crop-health-view.ts>> {
      -map: L.Map
      -cropHealthStore: CropHealthStore
      +selectedLayer: string
      +onChangeLayer(layer: string): void
      +onDownloadDataSheet(): void
    }
    class AgriculturalAlertsView <<agricultural-alerts-view.ts>> {
      -cropHealthStore: CropHealthStore
      +onOpenDetail(alertId: number): void
    }
    class AlertDetailView <<alert-detail-view.ts>> {
      -cropHealthStore: CropHealthStore
      +onCompleteStep(stepId: number): void
      +onFinalizeActionPlan(): void
    }
    class AdvisorConsultationView <<advisor-consultation-view.ts>> {
      -cropHealthStore: CropHealthStore
      +onMarkTreatmentApplied(prescriptionId: number): void
    }
    class PestReportForm <<pest-report-form.ts>> {
      -cropHealthStore: CropHealthStore
      +form: FormGroup
      +onSubmitReport(): void
    }
    class DiagnosisInboxView <<diagnosis-inbox-view.ts>> {
      -cropHealthStore: CropHealthStore
      +onOpenReport(reportId: number): void
      +onEvaluateTreatment(prescriptionId: number, effective: boolean): void
    }
    class PrescriptionForm <<prescription-form.ts>> {
      -cropHealthStore: CropHealthStore
      +form: FormGroup
      +onIssue(): void
    }
    class RegionalBulletinForm <<regional-bulletin-form.ts>> {
      -cropHealthStore: CropHealthStore
      +form: FormGroup
      +onIssue(): void
    }
  }

  class CropHealthRoutes <<crop-health.routes.ts>> {
    +routes: Routes
  }
}

CropHealthRoutes ..> IamGuard

SatelliteObservation --|> BaseEntity
ClimateForecast --|> BaseEntity
AgroclimaticAlert --|> BaseEntity
RegionalBulletin --|> BaseEntity
PestReport --|> BaseEntity
FieldInspection --|> BaseEntity
TechnicalPrescription --|> BaseEntity
ActionStep --|> BaseEntity
SatelliteObservationResource --|> BaseResource
AgroclimaticAlertResource --|> BaseResource
PestReportResource --|> BaseResource
TechnicalPrescriptionResource --|> BaseResource
SatelliteObservationsResponse --|> BaseResponse
ClimateForecastsResponse --|> BaseResponse
AgroclimaticAlertsResponse --|> BaseResponse
SatelliteObservationAssembler ..|> BaseAssembler
AgroclimaticAlertAssembler ..|> BaseAssembler
PestReportAssembler ..|> BaseAssembler
TechnicalPrescriptionAssembler ..|> BaseAssembler
SatelliteObservationsApiEndpoint --|> BaseApiEndpoint
ClimateForecastsApiEndpoint --|> BaseApiEndpoint
AgroclimaticAlertsApiEndpoint --|> BaseApiEndpoint
RegionalBulletinsApiEndpoint --|> BaseApiEndpoint
PestReportsApiEndpoint --|> BaseApiEndpoint
FieldInspectionsApiEndpoint --|> BaseApiEndpoint
TechnicalPrescriptionsApiEndpoint --|> BaseApiEndpoint
CropHealthApi --|> BaseApi

SatelliteObservation --> "1" SatelliteSource : "comes from"
AgroclimaticAlert --> "1" AlertType : "is of"
AgroclimaticAlert --> "1" AlertSeverity : "has"
AgroclimaticAlert --> "1" AlertStatus : "has"
AgroclimaticAlert "1" *-- "1..*" ActionStep : "plans"
PestReport --> "1" PestReportStatus : "has"
PestReport "1" --> "0..*" FieldInspection : "is inspected in"
PestReport "1" --> "0..1" TechnicalPrescription : "is treated by"
FieldInspection --> "1" InspectionStatus : "has"
TechnicalPrescription --> "1" PrescriptionStatus : "has"

CropHealthStore "1" --> "1" CropHealthApi
CropHealthStore "1" --> "1" OfflineSyncService
CropHealthStore "1" o-- "0..*" SatelliteObservation
CropHealthStore "1" o-- "0..*" AgroclimaticAlert
CropHealthStore "1" o-- "0..*" PestReport
CropHealthApi "1" *-- "1" SatelliteObservationsApiEndpoint
CropHealthApi "1" *-- "1" ClimateForecastsApiEndpoint
CropHealthApi "1" *-- "1" AgroclimaticAlertsApiEndpoint
CropHealthApi "1" *-- "1" RegionalBulletinsApiEndpoint
CropHealthApi "1" *-- "1" PestReportsApiEndpoint
CropHealthApi "1" *-- "1" FieldInspectionsApiEndpoint
CropHealthApi "1" *-- "1" TechnicalPrescriptionsApiEndpoint
SatelliteObservationsApiEndpoint "1" --> "1" SatelliteObservationAssembler
ClimateForecastsApiEndpoint "1" --> "1" ClimateForecastAssembler
AgroclimaticAlertsApiEndpoint "1" --> "1" AgroclimaticAlertAssembler
RegionalBulletinsApiEndpoint "1" --> "1" RegionalBulletinAssembler
PestReportsApiEndpoint "1" --> "1" PestReportAssembler
FieldInspectionsApiEndpoint "1" --> "1" FieldInspectionAssembler
TechnicalPrescriptionsApiEndpoint "1" --> "1" TechnicalPrescriptionAssembler

AlertDetailView ..> CompleteActionStepCommand
AlertDetailView ..> CloseAlertCommand
PestReportForm ..> UploadPestEvidencePhotoCommand
DiagnosisInboxView ..> RecordDamageAssessmentCommand
DiagnosisInboxView ..> ScheduleFieldInspectionCommand
DiagnosisInboxView ..> EvaluateTreatmentEffectivenessCommand
PrescriptionForm ..> IssueTechnicalPrescriptionCommand
AdvisorConsultationView ..> ConfirmTreatmentApplicationCommand
AdvisorConsultationView ..> ReportFoliageRecoveryCommand
RegionalBulletinForm ..> IssueRegionalBulletinCommand
CropHealthView --> "1" CropHealthStore
AgriculturalAlertsView --> "1" CropHealthStore
AlertDetailView --> "1" CropHealthStore
AdvisorConsultationView --> "1" CropHealthStore
PestReportForm --> "1" CropHealthStore
DiagnosisInboxView --> "1" CropHealthStore
PrescriptionForm --> "1" CropHealthStore
RegionalBulletinForm --> "1" CropHealthStore

