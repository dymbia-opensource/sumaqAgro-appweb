@startuml iam-web-class-diagram
title Code View: SumaqAgro - Web Application - IAM Component
caption Code diagram (C4 level 4) of the IAM Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  abstract class BaseApi <<base-api.ts>>
}

package "src/app/iam" {
  package "domain/model" {
    package "entities" {
      class User <<user.entity.ts>> {
        -_email: string
        -_role: UserRole
        +constructor(user: {id: number, email: string, role: UserRole})
        +get email(): string
        +get role(): UserRole
      }

      class AuthenticatedUser <<authenticated-user.entity.ts>> {
        -_userId: number
        -_email: string
        -_token: string
        -_role: UserRole
        +get userId(): number
        +get token(): string
        +get role(): UserRole
        +hasRole(role: UserRole): boolean
      }

      enum UserRole {
        FARMER
        COOPERATIVE_MANAGER
        AGRONOMIST
      }
    }

    package "commands" {
      class SignUpCommand <<sign-up.command.ts>> {
        +email: string
        +password: string
        +role: UserRole
      }
      class SignInCommand <<sign-in.command.ts>> {
        +email: string
        +password: string
      }
      class RequestPasswordResetCommand <<request-password-reset.command.ts>> {
        +email: string
      }
      class ResetPasswordCommand <<reset-password.command.ts>> {
        +token: string
        +newPassword: string
      }
    }
  }

  package "application" {
    class IamStore <<iam.store.ts>> {
      -isSignedInSignal: WritableSignal<boolean>
      -currentUserSignal: WritableSignal<AuthenticatedUser | null>
      -errorSignal: WritableSignal<string | null>
      +isSignedIn: Signal<boolean>
      +currentUser: Signal<AuthenticatedUser | null>
      +currentToken: Signal<string | null>
      +signUp(command: SignUpCommand, router: Router): void
      +signIn(command: SignInCommand, router: Router): void
      +signOut(router: Router): void
      +requestPasswordReset(command: RequestPasswordResetCommand): void
      +resetPassword(command: ResetPasswordCommand, router: Router): void
    }
  }

  package "infrastructure" {
    class IamApi <<iam-api.ts>> {
      -signUpEndpoint: SignUpApiEndpoint
      -signInEndpoint: SignInApiEndpoint
      -passwordRecoveryEndpoint: PasswordRecoveryApiEndpoint
      +signUp(command: SignUpCommand): Observable<User>
      +signIn(command: SignInCommand): Observable<AuthenticatedUser>
      +requestPasswordReset(command: RequestPasswordResetCommand): Observable<void>
      +resetPassword(command: ResetPasswordCommand): Observable<void>
    }

    package "endpoints" {
      class SignUpApiEndpoint <<sign-up.endpoint.ts>> {
        -http: HttpClient
        -assembler: SignUpAssembler
        +signUp(command: SignUpCommand): Observable<User>
      }
      class SignInApiEndpoint <<sign-in.endpoint.ts>> {
        -http: HttpClient
        -assembler: SignInAssembler
        +signIn(command: SignInCommand): Observable<AuthenticatedUser>
      }
      class PasswordRecoveryApiEndpoint <<password-recovery.endpoint.ts>> {
        -http: HttpClient
        -assembler: PasswordRecoveryAssembler
        +requestReset(command: RequestPasswordResetCommand): Observable<void>
        +reset(command: ResetPasswordCommand): Observable<void>
      }
    }

    package "assemblers" {
      class SignUpAssembler <<sign-up.assembler.ts>> {
        +toRequestFromCommand(command: SignUpCommand): SignUpRequest
        +toEntityFromResponse(response: SignUpResponse): User
      }
      class SignInAssembler <<sign-in.assembler.ts>> {
        +toRequestFromCommand(command: SignInCommand): SignInRequest
        +toEntityFromResponse(response: SignInResponse): AuthenticatedUser
      }
      class PasswordRecoveryAssembler <<password-recovery.assembler.ts>> {
        +toForgotPasswordRequest(command: RequestPasswordResetCommand): ForgotPasswordRequest
        +toResetPasswordRequest(command: ResetPasswordCommand): ResetPasswordRequest
      }
    }

    package "requests" {
      interface SignUpRequest <<sign-up.request.ts>> {
        +email: string
        +password: string
        +roles: string[]
      }
      interface SignInRequest <<sign-in.request.ts>> {
        +email: string
        +password: string
      }
      interface ForgotPasswordRequest <<forgot-password.request.ts>> {
        +email: string
      }
      interface ResetPasswordRequest <<reset-password.request.ts>> {
        +token: string
        +newPassword: string
      }
    }

    package "responses" {
      interface SignUpResponse <<sign-up.response.ts>> {
        +id: number
        +email: string
        +roles: string[]
      }
      interface SignInResponse <<sign-in.response.ts>> {
        +id: number
        +email: string
        +token: string
        +roles: string[]
      }
    }

    class IamGuard <<iam.guard.ts>> {
      +canActivate(route: ActivatedRouteSnapshot): boolean | UrlTree
    }
    class IamInterceptor <<iam.interceptor.ts>> {
      +intercept(request: HttpRequest, next: HttpHandlerFn): Observable<HttpEvent>
    }
  }

  package "presentation" {
    package "views" {
      class SignUpForm <<sign-up-form.ts>> {
        -iamStore: IamStore
        +form: FormGroup
        +onSubmit(): void
      }
      class SignInForm <<sign-in-form.ts>> {
        -iamStore: IamStore
        +form: FormGroup
        +onSubmit(): void
      }
      class ForgotPasswordForm <<forgot-password-form.ts>> {
        -iamStore: IamStore
        +form: FormGroup
        +onSubmit(): void
      }
      class ResetPasswordForm <<reset-password-form.ts>> {
        -iamStore: IamStore
        +form: FormGroup
        +onSubmit(): void
      }
    }
    package "components" {
      class LogoutMenuItem <<logout-menu-item.ts>> {
        -iamStore: IamStore
        +onSignOut(): void
      }
    }
  }
}

User --|> BaseEntity
User --> "1" UserRole : "has"
AuthenticatedUser --> "1" UserRole : "has"
SignUpResponse --|> BaseResponse
SignInResponse --|> BaseResponse
IamApi --|> BaseApi

IamStore "1" --> "1" IamApi
IamStore "1" --> "0..1" AuthenticatedUser
IamApi "1" *-- "1" SignUpApiEndpoint
IamApi "1" *-- "1" SignInApiEndpoint
IamApi "1" *-- "1" PasswordRecoveryApiEndpoint
SignUpApiEndpoint "1" --> "1" SignUpAssembler
SignInApiEndpoint "1" --> "1" SignInAssembler
PasswordRecoveryApiEndpoint "1" --> "1" PasswordRecoveryAssembler
SignUpAssembler ..> SignUpRequest
SignUpAssembler ..> SignUpResponse
SignInAssembler ..> SignInRequest
SignInAssembler ..> SignInResponse
PasswordRecoveryAssembler ..> ForgotPasswordRequest
PasswordRecoveryAssembler ..> ResetPasswordRequest
IamGuard ..> IamStore
IamInterceptor ..> IamStore

SignUpForm ..> SignUpCommand
SignInForm ..> SignInCommand
ForgotPasswordForm ..> RequestPasswordResetCommand
ResetPasswordForm ..> ResetPasswordCommand
SignUpForm --> "1" IamStore
SignInForm --> "1" IamStore
ForgotPasswordForm --> "1" IamStore
ResetPasswordForm --> "1" IamStore
LogoutMenuItem --> "1" IamStore

' --- vertical layout ---
SignUpForm -[hidden]down- ResetPasswordForm
SignUpRequest -[hidden]down- ResetPasswordRequest
SignUpCommand -[hidden]down- ResetPasswordCommand
BaseEntity -[hidden]down- BaseApi
ResetPasswordForm -[hidden]down- LogoutMenuItem
LogoutMenuItem -[hidden]down- IamStore
IamStore -[hidden]down- IamApi
IamStore -[hidden]down- IamInterceptor
IamApi -[hidden]down- SignUpApiEndpoint
IamInterceptor -[hidden]down- PasswordRecoveryApiEndpoint
SignUpApiEndpoint -[hidden]down- SignUpAssembler
PasswordRecoveryApiEndpoint -[hidden]down- PasswordRecoveryAssembler
SignUpAssembler -[hidden]down- SignUpRequest
PasswordRecoveryAssembler -[hidden]down- ForgotPasswordRequest
ResetPasswordRequest -[hidden]down- SignUpResponse
ResetPasswordRequest -[hidden]down- SignInResponse
SignUpResponse -[hidden]down- User
SignInResponse -[hidden]down- UserRole
User -[hidden]down- SignUpCommand
UserRole -[hidden]down- RequestPasswordResetCommand
ResetPasswordCommand -[hidden]down- BaseEntity
ResetPasswordCommand -[hidden]down- BaseResponse

@enduml
