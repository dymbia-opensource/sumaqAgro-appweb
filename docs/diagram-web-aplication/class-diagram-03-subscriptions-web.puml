@startuml subscriptions-web-class-diagram
title Code View: SumaqAgro - Web Application - Subscriptions and Payments Component
caption Code diagram (C4 level 4) of the Subscriptions and Payments Component, organized by DDD layers.
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
set separator none
scale max 8000*8000

package "src/app/shared" {
  class BaseEntity <<base-entity.ts>>
  interface BaseResource <<base-response.ts>>
  interface BaseResponse <<base-response.ts>>
  interface BaseAssembler <<base-assembler.ts>>
  abstract class BaseApiEndpoint <<base-api-endpoint.ts>>
  abstract class BaseApi <<base-api.ts>>
  class Money <<money.ts>>
}

package "src/app/iam" {
  class IamGuard <<iam.guard.ts>>
}

package "src/app/subscriptions" {
  package "domain/model" {
    package "entities" {
      class Plan <<plan.entity.ts>> {
        -_code: PlanCode
        -_name: string
        -_monthlyPrice: Money
        -_annualPrice: Money
        -_plotQuota: number
        -_features: string[]
        +get code(): PlanCode
        +priceFor(cycle: BillingCycle): Money
        +isFree(): boolean
      }

      class Subscription <<subscription.entity.ts>> {
        -_userId: number
        -_plan: Plan
        -_status: SubscriptionStatus
        -_billingCycle: BillingCycle
        -_startDate: Date
        -_endDate: Date
        -_autoRenew: boolean
        +get plan(): Plan
        +isActive(): boolean
        +remainingPlotSlots(registeredPlots: number): number
        +canRegisterPlot(registeredPlots: number): boolean
      }

      class Payment <<payment.entity.ts>> {
        -_subscriptionId: number
        -_amount: Money
        -_transactionToken: string
        -_status: PaymentStatus
        -_paidAt: Date
        +isCompleted(): boolean
      }

      enum PlanCode {
        SEED
        COOPERATIVE_PRO
        TECHNICAL_ADVISOR
      }

      enum SubscriptionStatus {
        ACTIVE
        CANCELLED
        EXPIRED
      }

      enum BillingCycle {
        MONTHLY
        ANNUAL
      }

      enum PaymentStatus {
        PENDING
        COMPLETED
        REJECTED
      }
    }

    package "commands" {
      class SelectSubscriptionPlanCommand <<select-subscription-plan.command.ts>> {
        +userId: number
        +planCode: PlanCode
        +billingCycle: BillingCycle
      }
      class SubmitPaymentCommand <<submit-payment.command.ts>> {
        +subscriptionId: number
        +cardToken: string
        +amount: Money
      }
      class CancelSubscriptionCommand <<cancel-subscription.command.ts>> {
        +subscriptionId: number
      }
    }
  }

  package "application" {
    class SubscriptionsStore <<subscriptions.store.ts>> {
      -plansSignal: WritableSignal<Plan[]>
      -subscriptionSignal: WritableSignal<Subscription | null>
      -paymentsSignal: WritableSignal<Payment[]>
      -billingCycleSignal: WritableSignal<BillingCycle>
      +plans: Signal<Plan[]>
      +subscription: Signal<Subscription | null>
      +payments: Signal<Payment[]>
      +loadPlans(): void
      +loadMySubscription(userId: number): void
      +selectPlan(command: SelectSubscriptionPlanCommand): void
      +submitPayment(command: SubmitPaymentCommand): void
      +cancelSubscription(command: CancelSubscriptionCommand): void
      +toggleBillingCycle(): void
      +downloadReceipt(paymentId: number): void
    }
  }

  package "infrastructure" {
    class SubscriptionsApi <<subscriptions-api.ts>> {
      -plansEndpoint: PlansApiEndpoint
      -subscriptionsEndpoint: SubscriptionsApiEndpoint
      -paymentsEndpoint: PaymentsApiEndpoint
      +getPlans(): Observable<Plan[]>
      +getSubscriptionByUserId(userId: number): Observable<Subscription>
      +selectPlan(command: SelectSubscriptionPlanCommand): Observable<Subscription>
      +submitPayment(command: SubmitPaymentCommand): Observable<Payment>
      +cancel(subscriptionId: number): Observable<Subscription>
      +getPayments(subscriptionId: number): Observable<Payment[]>
    }

    package "endpoints" {
      class PlansApiEndpoint <<plans.endpoint.ts>>
      class SubscriptionsApiEndpoint <<subscriptions.endpoint.ts>>
      class PaymentsApiEndpoint <<payments.endpoint.ts>>
    }

    package "assemblers" {
      class PlanAssembler <<plan.assembler.ts>> {
        +toEntityFromResource(resource: PlanResource): Plan
        +toResourceFromEntity(entity: Plan): PlanResource
        +toEntitiesFromResponse(response: PlansResponse): Plan[]
      }
      class SubscriptionAssembler <<subscription.assembler.ts>> {
        +toEntityFromResource(resource: SubscriptionResource): Subscription
        +toResourceFromEntity(entity: Subscription): SubscriptionResource
        +toEntitiesFromResponse(response: SubscriptionsResponse): Subscription[]
      }
      class PaymentAssembler <<payment.assembler.ts>> {
        +toEntityFromResource(resource: PaymentResource): Payment
        +toResourceFromEntity(entity: Payment): PaymentResource
        +toEntitiesFromResponse(response: PaymentsResponse): Payment[]
      }
    }


    package "responses" {
      interface PlanResource <<plan.response.ts>> {
        +id: number
        +code: string
        +name: string
        +monthlyPrice: number
        +annualPrice: number
        +currency: string
        +plotQuota: number
        +features: string[]
      }
      interface SubscriptionResource <<subscription.response.ts>> {
        +id: number
        +userId: number
        +planId: number
        +status: string
        +billingCycle: string
        +startDate: string
        +endDate: string
        +autoRenew: boolean
      }
      interface PaymentResource <<payment.response.ts>> {
        +id: number
        +subscriptionId: number
        +amount: number
        +currency: string
        +transactionToken: string
        +status: string
        +paidAt: string
      }
      interface PlansResponse <<plans.response.ts>> {
        +plans: PlanResource[]
      }
      interface SubscriptionsResponse <<subscriptions.response.ts>> {
        +subscriptions: SubscriptionResource[]
      }
      interface PaymentsResponse <<payments.response.ts>> {
        +payments: PaymentResource[]
      }
    }
  }

  package "presentation/views" {
    class PlansCatalogView <<plans-catalog-view.ts>> {
      -subscriptionsStore: SubscriptionsStore
      +onSelectPlan(planCode: PlanCode): void
      +onToggleBillingCycle(): void
    }
    class CheckoutView <<checkout-view.ts>> {
      -subscriptionsStore: SubscriptionsStore
      +form: FormGroup
      +onPay(): void
    }
    class BillingHistoryView <<billing-history-view.ts>> {
      -subscriptionsStore: SubscriptionsStore
      +onDownloadReceipt(paymentId: number): void
      +onCancelSubscription(): void
    }
  }

  class SubscriptionsRoutes <<subscriptions.routes.ts>> {
    +routes: Routes
  }
}

SubscriptionsRoutes ..> IamGuard

Plan --|> BaseEntity
Subscription --|> BaseEntity
Payment --|> BaseEntity
PlanResource --|> BaseResource
SubscriptionResource --|> BaseResource
PaymentResource --|> BaseResource
PlansResponse --|> BaseResponse
SubscriptionsResponse --|> BaseResponse
PaymentsResponse --|> BaseResponse
PlanAssembler ..|> BaseAssembler
SubscriptionAssembler ..|> BaseAssembler
PaymentAssembler ..|> BaseAssembler
PlansApiEndpoint --|> BaseApiEndpoint
SubscriptionsApiEndpoint --|> BaseApiEndpoint
PaymentsApiEndpoint --|> BaseApiEndpoint
SubscriptionsApi --|> BaseApi

Plan --> "1" PlanCode : "is identified by"
Plan --> "2" Money
Subscription "0..*" --> "1" Plan : "is based on"
Subscription --> "1" SubscriptionStatus : "has"
Subscription --> "1" BillingCycle : "is billed"
Subscription "1" *-- "0..*" Payment : "is paid by"
Payment --> "1" PaymentStatus : "has"
Payment --> "1" Money

SubscriptionsStore "1" --> "1" SubscriptionsApi
SubscriptionsStore "1" o-- "0..*" Plan
SubscriptionsStore "1" o-- "0..1" Subscription
SubscriptionsApi "1" *-- "1" PlansApiEndpoint
SubscriptionsApi "1" *-- "1" SubscriptionsApiEndpoint
SubscriptionsApi "1" *-- "1" PaymentsApiEndpoint
PlansApiEndpoint "1" --> "1" PlanAssembler
SubscriptionsApiEndpoint "1" --> "1" SubscriptionAssembler
PaymentsApiEndpoint "1" --> "1" PaymentAssembler

PlansCatalogView ..> SelectSubscriptionPlanCommand
CheckoutView ..> SubmitPaymentCommand
BillingHistoryView ..> CancelSubscriptionCommand
PlansCatalogView --> "1" SubscriptionsStore
CheckoutView --> "1" SubscriptionsStore
BillingHistoryView --> "1" SubscriptionsStore

' --- vertical layout ---
PlanResource -[hidden]down- PlansResponse
SubscriptionResource -[hidden]down- SubscriptionsResponse
PaymentResource -[hidden]down- PaymentsResponse
Plan -[hidden]down- PlanCode
Subscription -[hidden]down- SubscriptionStatus
Payment -[hidden]down- BillingCycle
PlanCode -[hidden]down- PaymentStatus
BaseEntity -[hidden]down- BaseAssembler
BaseResource -[hidden]down- BaseApiEndpoint
BaseResponse -[hidden]down- BaseApi
BaseAssembler -[hidden]down- Money
PlansCatalogView -[hidden]down- SubscriptionsStore
BillingHistoryView -[hidden]down- SubscriptionsStore
SubscriptionsStore -[hidden]down- SubscriptionsApi
SubscriptionsApi -[hidden]down- PlansApiEndpoint
SubscriptionsApi -[hidden]down- PaymentsApiEndpoint
PlansApiEndpoint -[hidden]down- PlanAssembler
PaymentsApiEndpoint -[hidden]down- PaymentAssembler
PlanAssembler -[hidden]down- PlanResource
PaymentAssembler -[hidden]down- PaymentResource
PlansResponse -[hidden]down- Plan
PaymentsResponse -[hidden]down- Payment
PaymentStatus -[hidden]down- SelectSubscriptionPlanCommand
PaymentStatus -[hidden]down- CancelSubscriptionCommand
SelectSubscriptionPlanCommand -[hidden]down- BaseEntity
CancelSubscriptionCommand -[hidden]down- BaseResponse

@enduml
